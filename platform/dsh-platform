def base_path():
    value = json.loads((asset_root() / "config" / "sites.json").read_text(encoding="utf-8"))["platform"]
    if not re.fullmatch(r"/[a-z][a-z0-9-]*/", value):
        raise PlatformError("工作区 config/sites.json 的 platform 基址无效。")
    return value


class PlatformError(Exception):
    pass


def asset_root():
    sys.path.insert(0, str(REPO / "runtime/adapters/dsh-container"))
    from workspace_paths import asset_root as selected_asset_root
    try:
        return selected_asset_root()
    except (OSError, ValueError):
