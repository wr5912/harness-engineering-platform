def platform_home():
    return (asset_root() / ".local" / "platform-home").resolve()


def check_workspace():
    descriptor = asset_root() / "workspace.json"
    try:
        value = json.loads(descriptor.read_text(encoding="utf-8"))
        if value.get("schemaVersion") != 1 or not re.fullmatch(r"workspace-[a-zA-Z0-9-]+", value.get("id", "")):
            raise ValueError()
    except (OSError, ValueError, TypeError, AttributeError):
        raise PlatformError(f"无法读取工作区身份：{descriptor}；请先准备独立数据工作区。") from None
    return value


def runtime_environment(home):
    environment = dict(os.environ)
    credentials = asset_root() / ".local" / "credentials" / "models.llm-api-key"
    if credentials.exists():
        try:
            values = json.loads(credentials.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            raise PlatformError("无法读取本地模型凭据 JSON 文件。") from None
        if not isinstance(values, dict):
            raise PlatformError("本地模型凭据必须是 JSON 字段映射。")
        for name in ("DEEPSEEK_API_KEY", "LOCAL_LLM_BASE_URL", "LOCAL_LLM_API_KEY", "XIAOMI_TOKEN_PLAN_CN_API_KEY"):
            if name not in values or name in environment:
                continue
            if not isinstance(values[name], str) or not values[name].strip():
                raise PlatformError(f"本地模型凭据字段 {name} 必须是非空字符串。")
            environment[name] = values[name]
    return {**environment, "DSH_HOME": str(home), "HARNESS_ASSET_ROOT": str(asset_root()),
            "HARNESS_PROGRAM_ROOT": str(REPO),
            "HARNESS_PYTHON": sys.executable,
            "HARNESS_SITES_CONFIG": str(asset_root() / "config" / "sites.json")}


def global_dsh(home):
    executable = shutil.which("dsh")
    if not executable:
        raise PlatformError("PATH 中没有全局 dsh；请先安装系统全局 DSH。")
    try:
        result = subprocess.run(
            [executable, "--version"], capture_output=True, text=True,
            env=runtime_environment(home), check=True, timeout=10,
        )
    except (OSError, subprocess.SubprocessError) as exc:
        raise PlatformError("无法读取全局 dsh 版本。") from exc
    version = result.stdout.strip()
    if not re.fullmatch(r"\d+\.\d+\.\d+(?:-[\w.-]+)?(?:\+[\w.-]+)?", version):
        raise PlatformError("全局 dsh --version 未返回有效版本。")
    manifest_path = PLUGIN / "package.json"
    try:
        manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
        peers = manifest["peerDependencies"]
        requirements = {name: value for name, value in peers.items()
                        if name.startswith("@deepseek-ai/dsh-")}
    except (OSError, ValueError, KeyError, AttributeError) as exc:
        raise PlatformError(f"无法读取插件兼容声明：{manifest_path}") from exc
    if not requirements:
        raise PlatformError("插件没有声明 DSH API peerDependencies。")
    incompatible = [f"{name}={required}" for name, required in requirements.items()
                    if required != version]
    if incompatible:
        raise PlatformError(
            f"全局 DSH {version} 与插件精确 peerDependencies 不兼容："
            + ", ".join(incompatible)
        )
    return str(Path(executable).absolute()), version


def rendered_profile():
    skill_dirs = [asset_root() / ".agents/skills"]
    skill_dirs += [asset_root() / item["path"] / "skills" for item in workspace_extensions()
                   if (asset_root() / item["path"] / "skills").is_dir()]
    result = {}
    for name in PROFILE_FILES:
        path = REPO / "platform" / "profile" / name
        try:
            source = path.read_text(encoding="utf-8")
        except OSError as exc:
            raise PlatformError(f"缺少平台 Profile 模板：{path}") from exc
        # JSON 字符串同样是合法 YAML 标量，可保留空格、引号等路径字符。
        runtime_name = PLATFORM_PATCH if name == "cordis.patch.yml" else name
        result[runtime_name] = source.replace(
            "{{HARNESS_PLATFORM_PLUGIN}}", json.dumps(str(PLUGIN / "lib" / "index.js"))
        ).replace(
            "{{HARNESS_PLATFORM_SKILL_DIRS}}", json.dumps([str(path) for path in skill_dirs])
        ).replace(
            "{{HARNESS_PLATFORM_WEBSERVER}}", json.dumps(str(WEB / "lib" / "platform-webserver.mjs"))
        )
    for extension in workspace_extensions():
        target = extension_output(extension, path_only=True)
        result[PLATFORM_PATCH] += ("\n- insert:\n    - id: " + json.dumps(extension["id"])
                                  + "\n      name: " + json.dumps(str(target / "plugin.js"))
                                  + "\n      disabled: false\n")
    return result


def workspace_extensions():
    declared = check_workspace().get("extensions", [])
    if not isinstance(declared, list):
        raise PlatformError("workspace.json extensions 必须是列表。")
    found = set()
    for item in declared:
        if not isinstance(item, dict) or not re.fullmatch(r"[a-z][a-z0-9-]*", item.get("id", "")) or item["id"] in found:
            raise PlatformError("工作区扩展 ID 无效或重复。")
        found.add(item["id"])
        relative = item.get("path")
        if not isinstance(relative, str) or not relative.startswith("extensions/") or ".." in Path(relative).parts:
            raise PlatformError("工作区扩展必须位于数据根 extensions/。")
        directory = (asset_root() / relative).resolve()
        if not directory.is_relative_to(asset_root()) or not (directory / "build.mjs").is_file():
            raise PlatformError("工作区扩展构建入口不存在或超出数据根。")
    return declared


def extension_output(extension, path_only=False):
    command = ["node", str(asset_root() / extension["path"] / "build.mjs")]
    if path_only:
        command.append("--path")
    try:
        result = subprocess.run(command, env=runtime_environment(platform_home()),
                                capture_output=True, text=True, check=True, timeout=120)
        output = Path(result.stdout.strip()).resolve()
        if not output.is_relative_to(asset_root() / ".local/build-cache"):
            raise ValueError()
        return output
    except (OSError, ValueError, subprocess.SubprocessError):
        raise PlatformError(f"扩展 {extension['id']} {'定位' if path_only else '构建'}失败；请检查对应构建入口。") from None


def link_program_asset(target, source, relative):
    """重建已知程序生成链接；保留普通文件、目录与不明来源链接。"""
    if target.is_symlink():
        previous = target.resolve()
        if previous == source:
            return
        parts = Path(relative).parts
        old_program = previous.parents[len(parts) - 1] if len(previous.parts) > len(parts) else None
        if (tuple(previous.parts[-len(parts):]) != parts or old_program is None
                or old_program.exists() and not (old_program / "platform/dsh-platform").is_file()):
            raise PlatformError(f"生成链接来源不明，保留原路径：{target}")
        target.unlink()
    elif target.exists():
        raise PlatformError(f"生成链接位置已被文件或目录占用，保留原路径：{target}")
    target.symlink_to(source, target_is_directory=True)


