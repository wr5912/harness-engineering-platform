#!/bin/sh
set -eu
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
BOOTSTRAP_SOURCE_COMMIT=4c6ef46ff36ddded2046e3fa1b5d36d62864a63f
BOOTSTRAP_DATA_COMMIT=34e0250ce621fde03777b70d9c852b2bf8e7efd7
BOOTSTRAP_SHA256=4adafac5069500b900ea741899374822a7e6591c322224865a9de1fff36ddc17

if [ "${1-}" = bootstrap ]; then
  shift
  BOOTSTRAP_MODE=1
else
  BOOTSTRAP_MODE=0
fi

if [ "$BOOTSTRAP_MODE" -eq 0 ] && [ -f "$SCRIPT_DIR/tool-env.sh" ] && [ -f "$SCRIPT_DIR/lab/cli.mts" ]; then
  . "$SCRIPT_DIR/tool-env.sh"
  exec node "$HEP_ROOT/platform/lab/cli.mts" "$@"
fi

if [ -x "$SCRIPT_DIR/hep-lab-bootstrap.sh" ]; then
  exec "$SCRIPT_DIR/hep-lab-bootstrap.sh" "$@"
fi

if [ "${1-}" = init ]; then shift; fi
TMP=$(mktemp "${TMPDIR:-/tmp}/hep-lab-bootstrap.XXXXXX")
cleanup() { rm -f "$TMP"; }
trap cleanup EXIT HUP INT TERM
URL="https://raw.githubusercontent.com/wr5912/harness-engineering-platform/$BOOTSTRAP_SOURCE_COMMIT/platform/hep-lab-bootstrap.sh"
if command -v curl >/dev/null 2>&1; then
  curl -fsSL --retry 2 -o "$TMP" -- "$URL"
elif command -v wget >/dev/null 2>&1; then
  wget -qO "$TMP" -- "$URL"
else
  echo "hep-lab: 独立入口缺少 curl 或 wget，无法下载固定 Bootstrap" >&2
  exit 2
fi
if command -v sha256sum >/dev/null 2>&1; then
  ACTUAL=$(sha256sum "$TMP" | awk '{print $1}')
elif command -v shasum >/dev/null 2>&1; then
  ACTUAL=$(shasum -a 256 "$TMP" | awk '{print $1}')
else
  echo "hep-lab: 独立入口缺少 sha256sum/shasum，无法校验 Bootstrap" >&2
  exit 2
fi
[ "$ACTUAL" = "$BOOTSTRAP_SHA256" ] || { echo "hep-lab: 固定 Bootstrap 校验失败" >&2; exit 2; }
HEP_LAB_DATA_COMMIT="$BOOTSTRAP_DATA_COMMIT" exec sh "$TMP" "$@"
