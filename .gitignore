# 操作系统与编辑器临时文件
.DS_Store
*.swp
*~

# Python 缓存与本地测试产物
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
.venv/
node_modules/

# 安装器生成的运行工具与启动入口
/bin/dsh
/bin/hep-env.sh
/bin/hep-start
/runtime/dsh/
/runtime/git/
/runtime/node/
/runtime/pnpm/
/runtime/python/
/runtime/python-site/

# 本地分析缓存
.code-review-graph/

# 本地环境文件；可提交的示例必须使用明确的 example 文件
.env
.env.*
!.env.example
!evolution/experiments/*/candidate/dsh/workspace/.env

# LLM API Key 可保存在仓库工作树，但禁止进入 Git 历史与远端
*.llm-api-key

# 本地开发入口；HOME/缓存/临时工作区
.local/

# 离线安装包输出
dist/
