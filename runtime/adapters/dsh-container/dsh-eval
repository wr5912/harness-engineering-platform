class EvaluationError(RuntimeError):
    pass


_cancel_requested = False
_defer_cancellation = 0
_cancel_reason = "evaluation-interrupted"


def request_cancellation(_signum, _frame) -> None:
    global _cancel_requested
    if _cancel_requested:
        return
    _cancel_requested = True
    if not _defer_cancellation:
        raise KeyboardInterrupt


def request_deadline(signum, frame) -> None:
    global _cancel_reason
    if not _cancel_requested:
        _cancel_reason = "budget-deadline-exceeded"
        request_cancellation(signum, frame)


@contextmanager
def defer_cancellation():
    """Run 初始化与封存不可被打断；初始化后在受清理保护的区块响应取消。"""
    global _defer_cancellation
    _defer_cancellation += 1
    try:
        yield
    finally:
        _defer_cancellation -= 1


@contextmanager
def allow_cancellation():
    """仅在拥有 Run 的异常处理区块内立即响应取消。"""
    global _defer_cancellation
    _defer_cancellation -= 1
    try:
        if _cancel_requested:
            raise KeyboardInterrupt
        yield
    finally:
        _defer_cancellation += 1


def progress(message: str) -> None:
    print(message, file=sys.stderr, flush=True)


def run_process(
    command: list[str],
    *,
    timeout: int,
    input_text: str | None = None,
    env: dict[str, str] | None = None,
) -> subprocess.CompletedProcess[str]:
    return run_cancellable_process(command, cwd=REPO, input_text=input_text,
                                   timeout=timeout, env=env)


def checked_process(
    command: list[str],
    *,
    label: str,
    timeout: int,
    input_text: str | None = None,
    env: dict[str, str] | None = None,
) -> subprocess.CompletedProcess[str]:
    try:
        completed = run_process(command, timeout=timeout, input_text=input_text, env=env)
    except (OSError, subprocess.TimeoutExpired) as error:
        raise EvaluationError(f"{label} 未完成：{type(error).__name__}") from error
    if completed.returncode != 0:
        raise EvaluationError(f"{label} 失败（退出码 {completed.returncode}）")
    return completed


def validation_check(script: Path, target: str) -> dict:
    try:
        completed = run_process([sys.executable, str(script), target], timeout=180)
    except (OSError, subprocess.TimeoutExpired) as error:
        return {"exit_code": None, "valid": False, "error": type(error).__name__}
    try:
        payload = json.loads(completed.stdout)
        if not isinstance(payload, dict):
            raise ValueError("校验结果必须是 JSON 对象")
    except ValueError:
        # 只保留末行诊断，避免把完整 traceback 或环境凭据写入评测日志。
        detail = (completed.stderr.strip().splitlines() or ["校验器未返回有效 JSON 对象"])[-1]
        for name, value in os.environ.items():
            if value and re.search(r"KEY|TOKEN|PASSWORD|SECRET", name, re.IGNORECASE):
                detail = detail.replace(value, "<redacted>")
        detail = re.sub(r"(?i)(Bearer\s+|(?:api[_-]?key|token|password|secret)[\"']?\s*[:=]\s*[\"']?)[^\s\"'&]+",
                        r"\1<redacted>", detail)
        return {"exit_code": completed.returncode, "valid": False, "error": detail[:500]}
    return {
        "exit_code": completed.returncode,
        "valid": completed.returncode == 0 and payload.get("valid") is True,
        "error_codes": [item.get("code") for item in payload.get("errors", [])],
    }


def validate_before_run(contract: dict) -> dict:
    return {
        "repository": validation_check(VALIDATE_REPOSITORY, str(REPO)),
        "experiment": validation_check(VALIDATE_EXPERIMENT, contract["experiment_root"]),
    }


def validate_after_run(contract: dict) -> None:
    check = validation_check(VALIDATE_EXPERIMENT, contract["experiment_root"])
    if not check["valid"]:
        detail = check.get("error") or ", ".join(str(code) for code in check.get("error_codes", []))
        raise EvaluationError(f"post-run-validation-failed（退出码 {check['exit_code']}）：{detail}")


def initialize_run(source: str, cases: list[dict], executor: str, selection_mode: str, review_mode: str,
                   model: str | None = None, compare_to: str | None = None) -> str:
    command = [
        sys.executable, str(RUN_RECORD), "--repo", str(REPO), "init",
        "--source", source, "--kind", "research", "--executor", executor,
        "--selection-mode", selection_mode, "--review-mode", review_mode,
    ]
    for case in cases:
        command.extend(("--case", case["case_id"]))
    if model:
        command.extend(("--model", model))
    if compare_to:
        command.extend(("--compare-to", compare_to))
    completed = checked_process(command, label="创建 Run", timeout=180)
    run_id = completed.stdout.strip()
    if not run_id.startswith("run-"):
        raise EvaluationError("创建 Run 未返回有效 run_id")
    return run_id


def record_trial(run_id: str, case_id: str, result: dict) -> None:
    row = {
        "run_id": run_id,
        "trial_id": "trial-" + str(uuid.uuid4()),
        "input_id": case_id,
        "execution_status": result["execution_status"],
        "verdict": result["verdict"],
        "observation": result["observation"],
        "evidence_ref": result["evidence_ref"],
    }
    if result.get("failure_reason"):
        row["failure_reason"] = result["failure_reason"]
    checked_process(
        [sys.executable, str(RUN_RECORD), "--repo", str(REPO), "record", "--run", run_id, "-"],
        label=f"记录 {case_id}", timeout=60,
        input_text=json.dumps(row, ensure_ascii=False),
    )


def finalize_run(run_id: str, status: str) -> None:
    checked_process(
        [
            sys.executable, str(RUN_RECORD), "--repo", str(REPO), "finalize",
            "--run", run_id, "--status", status,
        ],
        label="封存 Run", timeout=60,
    )


def write_json(path: Path, value: object) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(path.name + ".tmp")
    temporary.write_text(json.dumps(value, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    temporary.replace(path)


def write_unfinished_evidence(
    run_dir: Path,
    case: dict,
    reason: str,
    execution_status: str,
) -> dict:
    target = run_dir / "evidence" / case["case_id"]
    target.mkdir(parents=True, exist_ok=True)
    # 已采集的部分回答、轨迹、工具回执和诊断保持原样，只补尚不存在的文件。
    if not (target / "response.json").exists():
        write_json(target / "response.json", {
            "schema_version": "1.0", "case_id": case["case_id"], "response": None,
        })
    for name in ("trace.jsonl", "tools.jsonl"):
        if not (target / name).exists():
            (target / name).write_text("", encoding="utf-8")
    if not (target / "checks.json").exists():
        write_json(target / "checks.json", {
            "schema_version": "1.0",
            "case_id": case["case_id"],
            "completed": False,
            "expected_behavior": case["expected_behavior"],
            "failure_reason": reason,
        })
    write_json(target / "interruption.json", {
        "schema_version": "1.0", "case_id": case["case_id"],
        "execution_status": execution_status, "failure_reason": reason,
        "trace_available": (target / "trace.jsonl").stat().st_size > 0,
    })
    value = {
        "execution_status": execution_status,
        "verdict": "inconclusive",
        "observation": "评测已停止，该用例未执行。" if execution_status == "skipped"
        else "运行基础设施未完成该用例，未产生语义结论。",
        "evidence_ref": f"evidence/{case['case_id']}",
    }
    if execution_status == "error":
        value["failure_reason"] = reason
    return value


def export_response_artifacts(run_dir: Path, cases: list[dict], rows: dict[str, dict], filename: str) -> None:
    """显式请求时复制工具正式产物或真实最后回答，不替业务任务构造报告。"""
    artifacts = []
    for case in cases:
        case_id = case["case_id"]
        if rows.get(case_id, {}).get("execution_status") != "completed":
            continue
        response_path = run_dir / "evidence" / case_id / "response.json"
        response_bytes = response_path.read_bytes()
        texts = json.loads(response_bytes).get("assistant_texts", [])
        tool_artifact = exported_tool_markdown(run_dir, case_id)
        if tool_artifact:
            content, provenance = tool_artifact
        else:
            if not texts or not isinstance(texts[-1], str) or not texts[-1].strip():
                continue
            content = texts[-1].encode("utf-8")
            provenance = {"origin": "assistant-response", "source_evidence": response_path.relative_to(run_dir).as_posix(),
                          "source_sha256": hashlib.sha256(response_bytes).hexdigest(), "message_index": len(texts) - 1}
        relative = Path("artifacts") / case_id / filename
        output = run_dir / relative
        output.parent.mkdir(parents=True, exist_ok=True)
        output.write_bytes(content)
        artifacts.append({"path": relative.as_posix(), "media_type": "text/markdown", "case_id": case_id,
                          "sha256": hashlib.sha256(content).hexdigest(), "size": len(content),
                          **provenance})
    write_json(run_dir / "artifacts" / "index.json", {"schema_version": "1.0", "artifacts": artifacts})


def exported_tool_markdown(run_dir: Path, case_id: str):
    """只读取当前目标 Session 的正式工具回执；正文摘要不匹配时直接失败。"""
    evidence = run_dir / "evidence" / case_id
    tools_path = evidence / "tools.jsonl"
    checks = json.loads((evidence / "checks.json").read_text(encoding="utf-8"))
    root_log = checks.get("root_session_log")
    if not isinstance(root_log, str) or not tools_path.is_file():
        return None
    tools_bytes = tools_path.read_bytes()
    calls = {}
    selected = None

    def text_blocks(content):
        for block in content if isinstance(content, list) else []:
            if not isinstance(block, dict):
                continue
            if block.get("type") == "text" and isinstance(block.get("text"), str):
                yield block["text"]
            if isinstance(block.get("content"), list):
                yield from text_blocks(block["content"])

    for line_number, line in enumerate(tools_bytes.decode("utf-8").splitlines(), 1):
        if not line.strip():
            continue
        row = json.loads(line)
        if row.get("session_log") != root_log:
            continue
        event = row.get("event", {})
        data = event.get("data", {})
        if event.get("type") == "tool/call" and isinstance(data.get("callId"), str):
            calls[data["callId"]] = data.get("name")
        if event.get("type") != "tool/result":
            continue
        message = data.get("message", {})
        call_id = message.get("source", {}).get("callId")
        if call_id not in calls or data.get("error") or message.get("isError"):
            continue
        for text in text_blocks(message.get("content")):
            try:
                value = json.loads(text)
            except ValueError:
                continue
            if not isinstance(value, dict) or value.get("completed") is not True \
                    or not isinstance(value.get("markdown"), str) or not value["markdown"].strip() \
                    or "report_sha256" not in value:
                continue
            content = value["markdown"].encode("utf-8")
            digest = value["report_sha256"]
            if digest != hashlib.sha256(content).hexdigest():
                raise EvaluationError("tool-artifact-digest-mismatch")
            selected = (content, {"origin": "tool-result", "source_evidence": tools_path.relative_to(run_dir).as_posix(),
                                 "source_sha256": hashlib.sha256(tools_bytes).hexdigest(), "source_line": line_number,
                                 "source_call_id": call_id, "tool_name": calls[call_id],
                                 "tool_run_id": value.get("run_id"), "source_kind": value.get("source_kind")})
    return selected


def dsh_dev_command() -> list[str]:
    override = os.environ.get("DSH_EVAL_DSH_DEV")
    return [override] if override is not None else [sys.executable, str(DSH_DEV)]


def start_instance(source: str, name: str, model_policy_path: str | None = None) -> dict:
    command = [*dsh_dev_command(), "up", "--source", source, "--mode", "eval", "--name", name]
    if model_policy_path:
        command.extend(("--model-policy", model_policy_path))
    completed = checked_process(
        command,
        label="启动 DSH 评测实例", timeout=240, env=os.environ.copy(),
    )
    try:
        report = json.loads(completed.stdout)
    except json.JSONDecodeError as error:
        raise EvaluationError("DSH 启动结果不是 JSON") from error
    required = ("image_tag", "image_id", "image_ref", "image_build_fingerprint", "platform")
    if not isinstance(report, dict) or any(not isinstance(report.get(key), str) for key in required):
        raise EvaluationError("DSH 启动结果缺少有效镜像身份")
    if not re.fullmatch(r"sha256:[0-9a-f]{64}", report["image_id"]):
        raise EvaluationError("DSH 启动结果缺少有效镜像 ID")
    if not re.fullmatch(r"sha256:[0-9a-f]{64}", report["image_build_fingerprint"]):
        raise EvaluationError("DSH 启动结果缺少有效构建指纹")
    if report["image_ref"] != f"{report['image_tag']}@{report['image_id']}":
        raise EvaluationError("DSH 启动结果的不可变镜像引用不一致")
    return report


def authentication_url(name: str) -> str:
    completed = checked_process(
        [*dsh_dev_command(), "url", name, "--non-interactive"],
        label="取得 DSH 认证入口", timeout=90, env=os.environ.copy(),
    )
    url = completed.stdout.strip()
    try:
        parsed = urlsplit(url)
        valid = (parsed.scheme == "http" and parsed.hostname == "127.0.0.1"
                 and parsed.port is not None and 1 <= parsed.port <= 65535
                 and parsed.username is None and parsed.password is None
                 and parsed.path in ("/", strict_json(sites_config(REPO))["assistant"])
                 and not parsed.fragment)
    except ValueError:
        valid = False
    if not valid:
        raise EvaluationError("DSH 认证入口格式无效")
    return url


def stop_instance(name: str) -> bool:
    try:
        completed = run_process(
            [*dsh_dev_command(), "down", name], timeout=180, env=os.environ.copy(),
        )
    except (OSError, subprocess.TimeoutExpired, KeyboardInterrupt):
        return False
    return completed.returncode == 0


def driver_command(executor: str, image: str, evidence_root: Path) -> tuple[list[str], str]:
    driver = API_DRIVER if executor == "api" else BROWSER_DRIVER
    override = os.environ.get(f"DSH_EVAL_{executor.upper()}_DRIVER")
    if override:
        return [override], str(evidence_root)
    container_driver = f"/opt/dsh/apps/web/{driver.name}"
    return ([
        "docker", "run", "--rm", "-i", "--network", "host", "--read-only",
        "--tmpfs", "/tmp:rw,nosuid,nodev,size=256m", "--shm-size", "256m",
        "--cap-drop", "ALL", "--security-opt", "no-new-privileges:true",
        "--env", "HOME=/tmp",
        # 证据目录由宿主用户创建；执行器使用同一 UID/GID。
        "--user", f"{os.getuid()}:{os.getgid()}",
        "--entrypoint", "node",
        "--mount", f"type=bind,src={driver},dst={container_driver},readonly",
        "--mount", f"type=bind,src={COMMON_DRIVER},dst=/opt/dsh/apps/web/dsh-eval-common.mjs,readonly",
        "--mount", f"type=bind,src={evidence_root},dst=/work/evidence",
        image, container_driver,
    ], "/work/evidence")


def run_driver(
    executor: str,
    auth_url: str,
    cases: list[dict],
    contract: dict,
    evidence_root: Path,
    timeout_seconds: int,
    image_ref: str,
    on_case=None,
) -> dict:
    evidence_root.mkdir(parents=True, exist_ok=True)
    command, container_evidence = driver_command(executor, image_ref, evidence_root)
    payload = {
        "schema_version": "1.0",
        "auth_url": auth_url,
        "workspace": "/work/harness/workspace",
        "preset_id": contract["preset_id"],
        "timeout_ms": timeout_seconds * 1000,
        "evidence_root": container_evidence,
        "cases": cases,
        "declared_guard": contract.get("guard"),
    }
    if executor == "api":
        payload["judge_preset_id"] = "evaluation-judge"
    outer_timeout = timeout_seconds * sum(len(case["inputs"]) + 2 for case in cases) + 90
    def collect_results():
        if on_case is None:
            return
        for case in cases:
            path = evidence_root / case["case_id"] / "case-result.json"
            if path.is_file():
                value = json.loads(path.read_text(encoding="utf-8"))
                rows, _ = normalize_runtime_rows({"rows": [value]}, [case], executor)
                on_case(case["case_id"], rows[case["case_id"]])

    try:
        completed = run_cancellable_process(
            command, cwd=REPO, timeout=outer_timeout,
            input_text=json.dumps(payload, ensure_ascii=False), on_poll=collect_results,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        raise EvaluationError(f"{executor} 评测未完成：{type(error).__name__}") from error
    if completed.returncode != 0:
        raise EvaluationError(f"{executor} 评测失败（退出码 {completed.returncode}）")
    try:
        value = json.loads(completed.stdout)
    except json.JSONDecodeError as error:
        raise EvaluationError(f"{executor} 评测未返回 JSON") from error
    if not isinstance(value, dict) or not isinstance(value.get("rows"), list):
        raise EvaluationError(f"{executor} 评测缺少 rows")
    return value


def normalize_runtime_rows(
    value: dict,
    cases: list[dict],
    executor: str,
) -> tuple[dict[str, dict], str | None]:
    rows = value["rows"]
    stop_reason = value.get("stop_reason")
    if stop_reason is not None and stop_reason not in RUNTIME_STOP_REASONS:
        raise EvaluationError(f"{executor} 评测返回未知 stop_reason")
    expected_order = [case["case_id"] for case in cases]
    expected = set(expected_order)
    normalized = {}
    returned_order = []
    for row in rows:
        if not isinstance(row, dict) or not isinstance(row.get("case_id"), str):
            raise EvaluationError(f"{executor} 评测返回无效 Case")
        case_id = row["case_id"]
        if case_id not in expected or case_id in normalized:
            raise EvaluationError(f"{executor} 评测返回未知或重复 Case")
        returned_order.append(case_id)
        for field in ("execution_status", "verdict", "observation", "evidence_ref"):
            if not isinstance(row.get(field), str) or not row[field].strip():
                raise EvaluationError(f"{executor} 评测的 {case_id} 缺少 {field}")
        if row["execution_status"] not in {"completed", "error", "skipped"}:
            raise EvaluationError(f"{executor} 评测的 {case_id} execution_status 无效")
        if row["verdict"] not in {"passed", "failed", "inconclusive"}:
            raise EvaluationError(f"{executor} 评测的 {case_id} verdict 无效")
        if executor == "browser" and row["verdict"] != "inconclusive":
            raise EvaluationError(f"browser 冒烟不能判定 {case_id} 的业务语义")
        if row["execution_status"] != "completed" and row["verdict"] != "inconclusive":
            raise EvaluationError(f"{executor} 评测的 {case_id} 状态与 verdict 冲突")
        if row["execution_status"] == "error" and not str(row.get("failure_reason", "")).strip():
            raise EvaluationError(f"{executor} 评测的 {case_id} 缺少 failure_reason")
        normalized[case_id] = row
    if stop_reason is None and returned_order != expected_order:
        raise EvaluationError(f"{executor} 评测未覆盖全部用例")
    if stop_reason is not None:
        if not returned_order or returned_order != expected_order[:len(returned_order)]:
            raise EvaluationError(f"{executor} 停止前的 Case 顺序无效")
        if normalized[returned_order[-1]].get("failure_reason") != stop_reason:
            raise EvaluationError(f"{executor} 停止原因与最后一个 Case 不一致")
    return normalized, stop_reason


def select_case_ids(catalog: dict, patterns: list[str], mode: str) -> list[str]:
    if not patterns:
        if mode == "full":
            return catalog["case_ids"]
        selected = [item["case_id"] for item in catalog["catalog"] if item["fast"]]
        if not selected:
            raise EvaluationError("evaluation.md 没有标记 fast 的 Case；请标记或使用 --mode full/--case")
        return selected
    unmatched = [
        pattern for pattern in patterns
        if not any(fnmatchcase(case_id, pattern) for case_id in catalog["case_ids"])
    ]
    if unmatched:
        raise EvaluationError("未匹配 Case 模式：" + "、".join(unmatched))
    return [
        case_id for case_id in catalog["case_ids"]
        if any(fnmatchcase(case_id, pattern) for pattern in patterns)
    ]


def effective_required_env_names(contract: dict, model_policy_path: str | None,
                                 expected_model: str | None, *, source_only: bool = False) -> list[str]:
    """评测预检与实际 dsh-dev 启动共用模型策略及环境变量判定。"""
    if source_only:
        # 新建/编辑的纯来源 dry 校验不启动实例，也无需复制业务模型设置。
        return list(contract["required_env_names"])
    loader = SourceFileLoader("dsh_eval_dsh_dev", str(DSH_DEV))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    assert spec is not None
    dsh_dev = importlib.util.module_from_spec(spec)
    loader.exec_module(dsh_dev)
    try:
        policy = dsh_dev.read_model_policy(model_policy_path, contract["agent_id"], repo=REPO)
    except SystemExit as error:
        if model_policy_path:
            raise EvaluationError("当前来源的模型策略不可用，请核对设置 → 模型及实例策略") from error
        raise EvaluationError("业务统一默认模型在当前来源中无法直连；请核对设置 → 模型，或提供平台生成的 --model-policy") from error
    default = policy["default"]
    if expected_model and expected_model != default["model"]:
        raise EvaluationError("--model 与实例默认模型不一致；此参数只记录预期，不切换 Runtime")
    try:
        dsh_dev.assert_direct_model_available(contract, policy)
    except SystemExit as error:
        raise EvaluationError("业务统一默认模型在当前来源中无法直连；请提供平台生成的 --model-policy") from error
    return dsh_dev.required_env_names({**contract, "model_policy": policy})


def dry_run_payload(contract: dict, cases: list[dict], executor: str, requested_mode: str,
                    selection_mode: str, review_mode: str, model_policy_path: str | None = None,
                    expected_model: str | None = None, *, source_only: bool = False) -> dict:
    required = effective_required_env_names(contract, model_policy_path, expected_model, source_only=source_only)
    return {
        "schema_version": "1.0",
        "preflight_scope": "source-and-cases" if source_only else "source-cases-and-model-policy",
        "source_id": contract["source_id"],
        "experiment_id": contract["experiment_id"],
        "executor": executor,
        "requested_mode": requested_mode,
        "selection_mode": selection_mode,
        "review_mode": review_mode,
        "case_ids": [case["case_id"] for case in cases],
        "runtime_required": True,
        "image": contract["image"]["local_image_tag"],
        "image_build_fingerprint": contract["image"]["build_fingerprint"],
        "required_env_names": required,
        "missing_env_names": [name for name in required if not os.environ.get(name)],
    }


def result_payload(
    experiment_id: str | None,
    total: int,
    *,
    run_id: str | None = None,
    summary_path: Path | None = None,
    instance_stopped: bool = True,
    verdict: str | None = None,
    executor: str | None = None,
    cancelled: bool = False,
) -> dict:
    counts = {"total": total, "passed": 0, "failed": 0, "inconclusive": total}
    summary_ref = None
    report_ref = None
    review_status = None
    reviewed_cases = None
    if summary_path is not None and summary_path.is_file():
        summary = json.loads(summary_path.read_text(encoding="utf-8"))
        verdict = verdict or summary.get("effective_verdict", summary.get("overall_verdict"))
        verdict_counts = summary.get("machine_trial_verdict_counts", summary.get("verdict_counts"))
        counts = {
            "total": sum(verdict_counts.values()),
            "passed": verdict_counts["passed"],
            "failed": verdict_counts["failed"],
            "inconclusive": verdict_counts["inconclusive"],
        }
        review_status = summary.get("review_status")
        reviewed_counts = summary.get("reviewed_case_verdict_counts")
        if reviewed_counts is not None:
            reviewed_cases = {"total": sum(reviewed_counts.values()), **reviewed_counts}
        summary_ref = str(summary_path.relative_to(REPO))
        report_path = summary_path.with_name("report.md")
        if report_path.is_file():
            report_ref = str(report_path.relative_to(REPO))
    return {
        "run_id": run_id,
        "experiment_id": experiment_id,
        "executor": executor,
        "verdict": verdict or "inconclusive",
        "cases": counts,
        "review_status": review_status,
        "reviewed_cases": reviewed_cases,
        "summary": summary_ref,
        "report": report_ref,
        "instance_stopped": instance_stopped,
        "cancelled": cancelled,
    }


def emit_result(*args, **kwargs) -> None:
    print(json.dumps(result_payload(*args, **kwargs), ensure_ascii=False, separators=(",", ":")))


def execute(args: argparse.Namespace) -> int:
    source_only = bool(getattr(args, "source_check", False))
    if source_only and (not args.dry_run or getattr(args, "model_policy", None) or getattr(args, "model", None)):
        raise EvaluationError("--source-check 只用于不指定模型的 --dry-run 来源与 Case 校验")
    contract = resolve(args.source, repo=REPO)
    evaluation_path = REPO / "agents" / contract["agent_id"] / "evaluation.md"
    catalog = load_evaluation(evaluation_path)
    selection_mode = "explicit" if args.case else args.mode
    if args.executor == "browser" and args.review == "ai":
        raise EvaluationError("浏览器通道仅执行 UI 冒烟；业务复核请使用 --executor api")
    review_mode = "none" if args.executor == "browser" else args.review or ("ai" if selection_mode == "full" else "none")
    case_ids = select_case_ids(catalog, args.case, args.mode)
    cases = execution_for(evaluation_path, case_ids)
    model_policy_path = getattr(args, "model_policy", None)
    expected_model = getattr(args, "model", None)
    plan = dry_run_payload(contract, cases, args.executor, args.mode, selection_mode, review_mode,
                           model_policy_path, expected_model,
                           source_only=source_only)
    if args.compare_to:
        plan["compare_to_run_id"] = args.compare_to
    if args.dry_run:
        print(json.dumps(plan, ensure_ascii=False, indent=2))
        return 0
    if plan["missing_env_names"]:
        progress("缺少运行时环境变量：" + "、".join(plan["missing_env_names"]))
        emit_result(contract["experiment_id"], len(cases), executor=args.executor)
        return 2

    progress("执行仓库与 Experiment 前置校验")
    checks = validate_before_run(contract)
    invalid = [name for name, check in checks.items() if check.get("valid") is not True]
    if invalid:
        progress("前置校验未通过：" + "、".join(invalid))
        for name in invalid:
            check = checks[name]
            detail = check.get("error") or ", ".join(str(code) for code in check.get("error_codes", []))
            progress(f"{name}（退出码 {check.get('exit_code')}）：{detail}")
        emit_result(contract["experiment_id"], len(cases), executor=args.executor)
        return 2

    # 从创建 Run 到收尾返回始终持有取消所有权，只有实际执行阶段允许中断。
    with defer_cancellation():
        return execute_owned_run(args, contract, cases, selection_mode, review_mode)


def execute_owned_run(args: argparse.Namespace, contract: dict, cases: list[dict],
                      selection_mode: str, review_mode: str) -> int:
    progress("创建并锁定 Research Run")
    try:
        run_id = initialize_run(args.source, cases, args.executor, selection_mode, review_mode,
                                args.model, args.compare_to)
        run_dir = Path(contract["experiment_root"]) / "runs" / run_id
        # 初始化后的冻结输入是执行与评审共同使用的事实源。
        locked_inputs = json.loads((run_dir / "inputs.lock.json").read_text(encoding="utf-8"))
        cases = locked_inputs["evaluation_cases"]
        progress(f"Research Run: {run_id}")
        recorded: set[str] = set()
        instance_name = f"{contract['agent_id']}-eval-{uuid.uuid4().hex[:8]}"
        execution = {"schema_version": "1.0", "job_id": os.environ.get("HARNESS_EVAL_JOB_ID"),
                     "pid": os.getpid(), "run_id": run_id, "instance_name": instance_name,
                     "status": "running", "deadline_at": os.environ.get("HARNESS_EVAL_DEADLINE_AT")}
        write_json(run_dir / "execution.json", execution)
        up_attempted = False
        fatal_reason = None
        interrupted = False
        cleanup_failed = False
        runtime_rows: dict[str, dict] = {}
        stop_reason = None
    except EvaluationError as error:
        progress(f"创建 Run 失败：{error}")
        emit_result(contract["experiment_id"], len(cases), executor=args.executor)
        return 2
    try:
        with allow_cancellation():
            progress("启动独立 DSH 评测实例")
            up_attempted = True
            image_identity = start_instance(args.source, instance_name, getattr(args, "model_policy", None))
            if image_identity["image_build_fingerprint"] != contract["image"]["build_fingerprint"]:
                raise EvaluationError("DSH 实际镜像身份与本次来源合同不一致")
            write_json(run_dir / "evidence" / "dsh-image.json", {
                "schema_version": "1.0",
                "source_id": contract["source_id"],
                "local_image_tag": image_identity["image_tag"],
                "local_image_id": image_identity["image_id"],
                "image_ref": image_identity["image_ref"],
                "image_build_fingerprint": image_identity["image_build_fingerprint"],
                "platform": image_identity["platform"],
                "scope": "actual DSH evaluation runtime image identity; no semantic verdict",
            })
            auth_url = authentication_url(instance_name)
            def persist_case(case_id, value):
                if case_id not in recorded:
                    with defer_cancellation():
                        record_trial(run_id, case_id, value)
                        recorded.add(case_id)
                if _cancel_requested:
                    raise KeyboardInterrupt

            runtime_rows, stop_reason = normalize_runtime_rows(
                run_driver(
                    args.executor, auth_url, cases, contract,
                    run_dir / "evidence", args.timeout_seconds, image_identity["image_ref"], persist_case,
                ),
                cases,
                args.executor,
            )
            stop_index = None
            if stop_reason is not None:
                stopped_case = next(reversed(runtime_rows))
                stop_index = next(index for index, case in enumerate(cases) if case["case_id"] == stopped_case)
                progress(f"{args.executor} 执行器停止：{stop_reason}")
            for index, case in enumerate(cases):
                value = write_unfinished_evidence(run_dir, case, stop_reason, "skipped") \
                    if stop_index is not None and index > stop_index else runtime_rows[case["case_id"]]
                persist_case(case["case_id"], value)
                if _cancel_requested:
                    raise KeyboardInterrupt
            if args.export_response_markdown:
                export_response_artifacts(run_dir, cases, runtime_rows, args.export_response_markdown)
            inputs = json.loads((run_dir / "inputs.lock.json").read_text(encoding="utf-8"))
            rows = [json.loads(line) for line in (run_dir / "results.jsonl").read_text(encoding="utf-8").splitlines()]
            if review_mode == "ai":
                progress("启动独立 DSH 分析实例，逐场景复核全部 Case 证据")
                analysis = review_full(run_dir, rows, inputs, timeout_seconds=args.timeout_seconds)
            else:
                analysis = analyze(run_dir, rows, inputs, status="completed")
            write_json(run_dir / "analysis.json", analysis)
            if review_mode == "ai" and analysis["review_status"] != "completed":
                raise EvaluationError(analysis["review_reason"])
    except KeyboardInterrupt:
        interrupted = True
        fatal_reason = _cancel_reason
    except EvaluationError as error:
        fatal_reason = str(error)
    except ProcessCleanupError as error:
        cleanup_failed = True
        interrupted = _cancel_requested
        fatal_reason = str(error)
    except Exception as error:
        fatal_reason = f"evaluation-runtime-{type(error).__name__}"
    finally:
        stopped = (stop_instance(instance_name) if up_attempted else True) and not cleanup_failed
        if not stopped and fatal_reason is None:
            fatal_reason = "instance-stop-unconfirmed"

    if _cancel_requested and fatal_reason is None:
        interrupted = True
        fatal_reason = _cancel_reason
    if fatal_reason:
        progress(f"评测未完整执行：{fatal_reason}")
        unfinished_status = "skipped" if interrupted else "error"
        for case in cases:
            if case["case_id"] not in recorded:
                receipt_path = run_dir / "evidence" / case["case_id"] / "case-result.json"
                if receipt_path.is_file():
                    rows, _ = normalize_runtime_rows({"rows": [json.loads(receipt_path.read_text(encoding="utf-8"))]}, [case], args.executor)
                    value = rows[case["case_id"]]
                else:
                    value = write_unfinished_evidence(run_dir, case, fatal_reason, unfinished_status)
                record_trial(run_id, case["case_id"], value)
        write_json(run_dir / "execution.json", {**execution, "status": "cancelled" if interrupted and stopped else "failed",
                   "instance_stopped": stopped, "failure_reason": fatal_reason})
        finalize_run(run_id, "cancelled" if interrupted and stopped else "failed")
        summary_path = run_dir / "summary.json"
        try:
            validate_after_run(contract)
        except EvaluationError as error:
            progress(f"Run 后置校验失败：{error}")
        emit_result(
            contract["experiment_id"], len(cases), run_id=run_id,
            summary_path=summary_path, instance_stopped=stopped, verdict="inconclusive",
            executor=args.executor,
            cancelled=interrupted,
        )
        return 2

    write_json(run_dir / "execution.json", {**execution, "status": "completed", "instance_stopped": stopped})
    finalize_run(run_id, "completed")
    summary_path = run_dir / "summary.json"
    summary = json.loads(summary_path.read_text(encoding="utf-8"))
    progress("执行 Experiment 后置校验")
    try:
        validate_after_run(contract)
    except EvaluationError as error:
        progress(f"Run 后置校验失败：{error}")
        emit_result(
            contract["experiment_id"], len(cases), run_id=run_id,
            summary_path=summary_path, instance_stopped=stopped, verdict="inconclusive",
            executor=args.executor,
        )
        return 2
    emit_result(
        contract["experiment_id"], len(cases), run_id=run_id,
        summary_path=summary_path, instance_stopped=stopped, executor=args.executor,
    )
    if args.executor == "browser":
        return 0 if all(row["execution_status"] == "completed" for row in runtime_rows.values()) else 1
    return 0 if summary.get("effective_verdict", summary.get("overall_verdict")) == "passed" else 1


def main() -> None:
    global _cancel_requested, _cancel_reason, REPO
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--repo", type=Path, default=REPO, help="用户数据工作区根目录")
    parser.add_argument("--source", required=True, help="experiment:<id> 或已登记 Experiment ID")
    parser.add_argument("--mode", choices=("fast", "full"), default="fast", help="评测档位；默认 fast")
    parser.add_argument(
        "--case", action="append", default=[],
        help="覆盖 --mode，显式选择业务 Case；支持通配符、可重复，按 evaluation.md 顺序执行",
    )
    parser.add_argument("--executor", choices=("api", "browser"), default="api", help="执行通道")
    parser.add_argument("--review", choices=("ai", "none"), help="API 证据复核；默认 full 为 ai，其余为 none；浏览器仅支持 none")
    parser.add_argument("--model", help="记录本次 Session 预期使用的模型 ID，不改变 Runtime 设置")
    parser.add_argument("--model-policy", metavar="PATH",
                        help="平台投影的非秘密模型策略 JSON；用于评测实例装载并按策略核对环境变量")
    parser.add_argument("--compare-to", help="已封存的同 Agent Run ID，自动生成观察性对照")
    parser.add_argument("--export-response-markdown", help="显式导出各已完成 Case 的最后真实回答；指定不含目录的 .md 文件名")
    parser.add_argument("--dry-run", action="store_true", help="只解析计划，不写 Run、不启动进程")
    parser.add_argument("--source-check", action="store_true",
                        help="仅配 --dry-run：校验来源与 Case，不核对业务默认模型连接")
    parser.add_argument("--timeout-seconds", type=int, default=300, help="每轮等待上限（秒）")
    args = parser.parse_args()
    REPO = args.repo.expanduser().resolve()
    os.environ["HARNESS_ASSET_ROOT"] = str(REPO)
    if args.timeout_seconds < 10:
        parser.error("--timeout-seconds 不能小于 10")
    if args.export_response_markdown and not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,120}\.md", args.export_response_markdown):
        parser.error("--export-response-markdown 必须是不含目录的 .md 文件名")
    _cancel_requested = False
    _cancel_reason = "evaluation-interrupted"
    previous_handlers = {name: signal.signal(name, request_cancellation)
                         for name in (signal.SIGINT, signal.SIGTERM)}
    previous_alarm = None
    previous_timer = None
    try:
        deadline_text = os.environ.get("HARNESS_EVAL_DEADLINE_AT")
        if deadline_text and not args.dry_run:
            deadline = datetime.fromisoformat(deadline_text.replace("Z", "+00:00"))
            if deadline.tzinfo is None:
                raise ValueError("评测截止时间必须包含时区")
            remaining = (deadline - datetime.now(timezone.utc)).total_seconds()
            if remaining <= 0:
                request_deadline(None, None)
            previous_alarm = signal.signal(signal.SIGALRM, request_deadline)
            previous_timer = signal.setitimer(signal.ITIMER_REAL, remaining)
        raise SystemExit(execute(args))
    except KeyboardInterrupt:
        # 尚未进入拥有 Run/实例的执行区块，此时没有待清理的业务实例。
        emit_result(args.source.removeprefix("experiment:"), 0, executor=args.executor, cancelled=True)
        raise SystemExit(2)
    except (EvaluationError, ValueError) as error:
        progress(f"dsh-eval failed: {error}")
        source = args.source.removeprefix("experiment:")
        experiment_id = source if EXPERIMENT.fullmatch(source) else None
        emit_result(experiment_id, 0, executor=args.executor)
        raise SystemExit(2)
    finally:
        if previous_timer is not None:
            signal.setitimer(signal.ITIMER_REAL, *previous_timer)
        if previous_alarm is not None:
            signal.signal(signal.SIGALRM, previous_alarm)
        for name, handler in previous_handlers.items():
            signal.signal(name, handler)


if __name__ == "__main__":
    main()
