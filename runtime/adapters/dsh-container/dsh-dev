def running_dsh_image_id(name: str) -> tuple[str | None, bool]:
    """返回本实例运行中 dsh 容器的镜像 ID；第二项表示查询失败。"""
    listing = run(
        ["docker", "ps", "--filter", f"label=com.docker.compose.project={project_name(name)}",
         "--filter", "label=com.docker.compose.service=dsh", "--format", "{{.ID}}"],
        check=False,
    )
    if listing.returncode != 0:
        return None, True
    container_ids = [value.strip() for value in (listing.stdout or "").splitlines() if value.strip()]
    if not container_ids:
        return None, False
    inspected = run(["docker", "inspect", "--format", "{{.Image}}", container_ids[0]], check=False)
    image_id = (inspected.stdout or "").strip()
    if inspected.returncode != 0 or not IMAGE_ID_RE.fullmatch(image_id):
        return None, True
    return image_id, False


def validate_image_identity(contract: dict, current: tuple[Path, dict] | None = None,
                            replace: bool = False) -> dict:
    """在停机或写状态前确认标签指向带正确构建指纹的平台镜像。"""
    image = contract.get("image") or {}
    tag = image.get("local_image_tag")
    expected_fingerprint = image.get("build_fingerprint")
    expected_platform = image.get("platform")
    if not tag or not expected_fingerprint:
        fail("来源合同缺少镜像构建指纹；请重新解析当前来源")
    inspected = run(["docker", "image", "inspect", tag, "--format", "{{json .}}"], check=False)
    if inspected.returncode != 0:
        fail(f"本地镜像不存在：{tag}；请先执行 dsh-dev image build --source {contract['source_id']}")
    try:
        metadata = json.loads((inspected.stdout or "").strip())
    except json.JSONDecodeError:
        fail(f"无法解析镜像元数据：{tag}")
    if not isinstance(metadata, dict):
        fail(f"镜像元数据不是对象：{tag}")
    image_id = metadata.get("Id")
    config = metadata.get("Config")
    labels = config.get("Labels") if isinstance(config, dict) else {}
    if not isinstance(labels, dict):
        labels = {}
    actual_fingerprint = labels.get(IMAGE_LABEL_KEY)
    platform = f"{metadata.get('Os')}/{metadata.get('Architecture')}"
    if not IMAGE_ID_RE.fullmatch(str(image_id or "")):
        fail(f"镜像 {tag} 没有有效的 immutable image ID")
    if actual_fingerprint != expected_fingerprint:
        fail(
            f"镜像 {tag} 的构建指纹不匹配（期望 {expected_fingerprint}，实际 {actual_fingerprint or '缺失'}）；"
            f"请先执行 dsh-dev image build --source {contract['source_id']}"
        )
    if platform != expected_platform:
        fail(f"镜像 {tag} 平台不匹配（期望 {expected_platform}，实际 {platform}）")
    if current is not None:
        name = current[1].get("name") or current[0].name
        running_id, query_failed = running_dsh_image_id(name)
        if query_failed:
            fail(f"无法确认实例 {name} 当前 dsh 容器的镜像身份；为避免误停机，已拒绝启动")
        if running_id and running_id != image_id and not replace:
            fail(
                f"实例 {name} 当前运行镜像为 {running_id}，与待启动镜像 {image_id} 不同；"
                "请使用 --replace 明确重建实例"
            )
    return {
        "image_tag": tag,
        "image_id": image_id,
        "image_ref": image_reference(tag, image_id),
        "image_build_fingerprint": expected_fingerprint,
        "platform": platform,
    }


def command_up(args: argparse.Namespace) -> None:
    # 必须在选端口前加锁；仅锁写 instance.json 无法避免两个启动同时看到空闲端口。
    with nullcontext() if getattr(args, "dry_run", False) else instance_startup_lock():
        contract, current = prepare_up(args)
        inherited = existing_runtime_environment(args, contract, current)
        os.environ.update(inherited)
        try:
            _command_up(args, contract, current)
        finally:
            for name in inherited:
                os.environ.pop(name, None)


def _command_up(args: argparse.Namespace, contract: dict,
                current: tuple[Path, dict] | None) -> None:
    if getattr(args, "dry_run", False):
        print(json.dumps(build_plan(args, contract), ensure_ascii=False, indent=2, sort_keys=True))
        return
    if current is None:
        require_unused_docker_name(args.name)
    else:
        require_docker_registration(args.name, current[1])
    if getattr(args, "allow_missing_env", False):
        missing = [name for name in required_env_names(contract, args.analysis_workspace)
                   if not os.environ.get(name)]
        if missing:
            print(json.dumps({"warning": "缺少运行时环境变量，按显式降级启动（仅技术装载核验）",
                              "missing_env_names": missing}, ensure_ascii=False), file=sys.stderr)
    else:
        check_environment(contract, args.analysis_workspace)
    identity = validate_image_identity(contract, current=current, replace=getattr(args, "replace", False))
    # Compose 插值与模板结构都可以在停旧实例前检查；明显无效的新配置不得先触发停机。
    preflight_new_instance(args, contract)
    replaced = migrate_existing_instance(args, contract, current)
    if port_in_use(args.port):
        holder = running_instance_service(args.name)
        if holder == "dsh":
            fail(
                f"端口 {args.port} 正被本实例 {args.name} 自身占用。重载请先 dsh-dev down {args.name} 再同名 up，"
                f"或直接加 --replace 由本命令先停后启；本工具不自动改端口。"
            )
        fail(f"端口 {args.port} 已被占用；启动阶段不会静默改用其它端口，请重试或显式指定 --port")
    target = write_instance(
        args.name, mode=args.mode, contract=contract, port=args.port,
        image_id=identity["image_id"], lan_access=bool(getattr(args, "lan_access", False)),
        analysis_workspace=args.analysis_workspace,
        plugin_node_modules=getattr(args, "plugin_node_modules", None),
        trusted_host=getattr(args, "trusted_host", None),
        unsafe_no_auth=bool(getattr(args, "unsafe_no_auth", False)),
        skip_testing_notice=bool(getattr(args, "skip_testing_notice", False)),
        migrate_home=bool(getattr(args, "migrate_home", False)),
    )
    environment = compose_env(
        contract, args.mode, args.port, args.name,
        image_id=identity["image_id"], analysis_workspace=args.analysis_workspace,
        plugin_node_modules=getattr(args, "plugin_node_modules", None),
    )
    run(compose_command(target, args.name, "config", "--quiet"), env=environment)
    run(compose_command(target, args.name, "up", "-d", "--no-build"), env=environment)
    # `docker compose up -d` 返回 0 只说明命令成功，不说明容器在运行：容器可能立刻退出。
    containers = wait_for_service(args.name, "dsh")
    report = {"name": args.name, "container_name": args.name,
              "project": project_name(args.name), "port": args.port,
              "web_base_path": current_web_base_path(),
              "base_url": f"http://127.0.0.1:{args.port}{current_web_base_path()}",
              "state_dir": str(target), "agent_id": contract["agent_id"],
              "target_preset": target_preset(contract),
              "session_preset": session_preset(contract, args.mode, args.analysis_workspace),
              "profile": "web",
              "lan_access": bool(getattr(args, "lan_access", False)),
              "unsafe_no_auth": bool(getattr(args, "unsafe_no_auth", False)),
              "skip_testing_notice": bool(getattr(args, "skip_testing_notice", False)),
              "trusted_host": getattr(args, "trusted_host", None),
              "listen_host": "0.0.0.0" if getattr(args, "lan_access", False) else "127.0.0.1",
              **identity}
    if replaced:
        report["replaced"] = replaced
    if containers is None:
        report["dsh_running"] = "unknown"
        print(json.dumps(report, ensure_ascii=False, indent=2, sort_keys=True), file=sys.stderr)
        fail("无法查询容器状态，不能确认 dsh 服务是否已启动；用 logs 查看实例日志")
    running = [item for item in containers if item["service"] == "dsh" and item["state"] == "running"]
    report["dsh_running"] = bool(running)
    report["containers"] = [
        {"name": item["name"], "service": item["service"], "state": item["state"]}
        for item in containers
    ]
    if not running:
        print(json.dumps(report, ensure_ascii=False, indent=2, sort_keys=True), file=sys.stderr)
        fail("docker compose up 返回 0，但 dsh 服务没有进入运行状态；用 logs 查看失败原因")
    report["listener_verified"] = wait_for_instance_listener(args.name, args.port)
    if not report["listener_verified"]:
        print(json.dumps(report, ensure_ascii=False, indent=2, sort_keys=True), file=sys.stderr)
        fail("dsh 容器未确认拥有指定端口的监听；不能交付可能属于其它实例的入口，用 logs 查看失败原因")
    print(json.dumps(report, ensure_ascii=False, indent=2, sort_keys=True))
    print(json.dumps({
        "hint": web_cold_start_hint(args.mode, args.analysis_workspace),
        "workspace_to_register": workspace_to_register(args.mode, args.analysis_workspace),
    },
                     ensure_ascii=False), file=sys.stderr)


def command_ps(args: argparse.Namespace) -> None:
    show_all = bool(getattr(args, "all", False))
    entries = []
    unowned_record_count = 0
    try:
        observed = run(["node", str(ADAPTER / "instance-observation.ts")], check=False, timeout=12)
        observation = json.loads(observed.stdout) if observed.returncode == 0 else {}
        if not isinstance(observation, dict):
            observation = {}
    except (OSError, subprocess.TimeoutExpired, json.JSONDecodeError):
        observation = {}
    if STATE_ROOT.is_dir():
        for target in sorted(STATE_ROOT.iterdir()):
            manifest_path = target / "instance.json"
            if not manifest_path.is_file():
                continue
            # 共享状态内损坏的登记无法确认归属，不将名称或状态归入当前用户。
            owned = False
            try:
                manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
                if not isinstance(manifest, dict):
                    raise ValueError("状态文件根必须是 JSON 对象")
                if not instance_belongs_to_workspace(REPO, manifest):
                    continue
                owned = True
                entry = instance_entry(target, manifest, observation)
            except (OSError, ValueError, TypeError, KeyError, json.JSONDecodeError) as error:
                if not owned:
                    unowned_record_count += 1
                    continue
                entry = {
                    "name": target.name,
                    "state_dir": str(target),
                    "error": f"{type(error).__name__}: {error}",
                    "state": "unknown",
                    "ps_query": "unknown",
                }
                if show_all:
                    entries.append(entry)
                continue
            if show_all or entry.get("state") == "running":
                entries.append(entry)
    print(json.dumps({"schema_version": "1.0", "instances": entries,
                      "unowned_record_count": unowned_record_count}, ensure_ascii=False, indent=2, sort_keys=True))


def compose_ps_containers(output: str) -> list[dict] | None:
    """解析 Compose 的 JSON 输出；非空但非法的输出按未知处理。"""
    text = (output or "").strip()
    if not text:
        return []
    try:
        parsed = json.loads(text)
        values = parsed if isinstance(parsed, list) else [parsed]
    except json.JSONDecodeError:
        values = []
        for line in text.splitlines():
            try:
                value = json.loads(line)
            except json.JSONDecodeError:
                return None
            values.append(value)
    if any(not isinstance(value, dict) for value in values):
        return None
    containers = []
    for value in values:
        state = str(value.get("State", value.get("state", ""))).lower()
        status = str(value.get("Status", value.get("status", "")))
        exit_code = value.get("ExitCode", value.get("exit_code"))
        try:
            exit_code = int(exit_code) if exit_code is not None else None
        except (TypeError, ValueError):
            exit_code = None
        if exit_code is None:
            match = re.search(r"Exited \((-?\d+)\)", status)
            exit_code = int(match.group(1)) if match else None
        containers.append({
            "id": value.get("ID", value.get("id")),
            "state": state,
            "status": status,
            "name": value.get("Name", value.get("name")),
            "service": value.get("Service", value.get("service")),
            "exit_code": exit_code,
        })
    return containers


def normalized_instance_state(containers: list[dict] | None) -> str:
    """区分实际 DSH 容器状态、无容器登记和查询失败。"""
    if containers is None:
        return "unknown"
    dsh = [item for item in containers if item.get("service") == "dsh"]
    if not dsh:
        return "absent"
    if any(item.get("state") == "running" for item in dsh):
        return "running"
    if any(item.get("state") == "dead" or item.get("exit_code", 0) not in (None, 0) for item in dsh):
        return "failed"
    if any(item.get("state") in {"restarting", "paused"} for item in dsh):
        return "unknown"
    return "stopped"


def instance_entry(target: Path, manifest: dict, observation: dict | None = None) -> dict:
    """把一条实例状态渲染成 `ps` 条目；状态文件版本与当前不一致时标记需要迁移。"""
    name = str(manifest.get("name") or target.name)
    recorded_schema = manifest.get("schema_version")
    port = manifest.get("port")
    project = manifest.get("project") or project_name(name)
    if observation is None:
        require_docker_registration(name, manifest)
        listing = run(compose_command(target, name, "ps", "--all", "--format", "json"),
                      check=False, env=instance_compose_env(manifest))
    else:
        projects = observation.get("projects")
        listing = subprocess.CompletedProcess([], 0 if isinstance(projects, dict) else 1,
            stdout=json.dumps(projects.get(project, [])) if isinstance(projects, dict) else "",
            stderr="Docker 容器批量观察失败")
    if listing.returncode != 0:
        ps_state = "unknown"
        ps_detail = redact_secrets((listing.stderr or listing.stdout or "").strip())[-200:] or "docker compose ps 查询失败"
        state = "unknown"
        containers = None
    else:
        ps_state = "reported"
        ps_detail = (listing.stdout or "").strip() or "not running"
        containers = compose_ps_containers(listing.stdout)
        state = normalized_instance_state(containers)
        if observation is not None and not docker_registration_matches(name, projects.get(project, [])):
            ps_state, state, containers = "unknown", "unknown", None
            ps_detail = "同名 Docker 项目来自另一实例登记或无法确认归属；未认领该容器"
    observed_dsh = next(
        (item.get("name") for item in containers or []
         if item.get("service") == "dsh" and item.get("name")),
        None,
    )
    if observation is None or manifest.get("home_directory"):
        resolved_volume, home_preserved = home_volume(manifest)
    else:
        homes = observation.get("homes")
        resolved_volume = homes.get(project, f"{project}-home") if isinstance(homes, dict) else None
        home_preserved = project in homes if isinstance(homes, dict) else None
    return {
        "name": name,
        "container_name": observed_dsh or manifest.get("container_name"),
        "project": manifest.get("project") or project_name(name),
        "observed_at": datetime.now(timezone.utc).isoformat().replace("+00:00", "Z"),
        "source_id": manifest.get("source_id"),
        "source_kind": manifest.get("source_kind"),
        "mode": manifest.get("mode"),
        "purpose": manifest.get("purpose", PURPOSES.get(manifest.get("mode"), manifest.get("mode"))),
        "agent_id": manifest.get("agent_id"),
        "target_preset": manifest.get("target_preset"),
        "session_preset": manifest.get("session_preset"),
        "profile": manifest.get("profile", "web"),
        "lan_access": bool(manifest.get("lan_access", False)),
        "unsafe_no_auth": bool(manifest.get("unsafe_no_auth", False)),
        "skip_testing_notice": bool(manifest.get("skip_testing_notice", False)),
        "trusted_host": manifest.get("trusted_host"),
        "listen_host": manifest.get("listen_host", "127.0.0.1"),
        "state_schema": recorded_schema,
        "needs_migration": recorded_schema != INSTANCE_SCHEMA_VERSION,
        "state": state,
        "port": port,
        "image_tag": manifest.get("image_tag"),
        "image_id": manifest.get("image_id"),
        "image_build_fingerprint": manifest.get("image_build_fingerprint"),
        "mounts": manifest.get("mounts") or {},
        "mount_modes": manifest.get("mount_modes") or {},
        "home_volume": resolved_volume,
        "home_directory": manifest.get("home_directory"),
        "home_preserved": home_preserved,
        "state_dir": str(target),
        "context_mounts": [item.get("container") for item in manifest.get("context_mounts") or []],
        "web_base_path": manifest.get("web_base_path", "/"),
        "base_url": instance_base_url(manifest) if isinstance(port, int) else None,
        "ps_query": ps_state,
        "ps": ps_detail,
    }


def running_instance_service(name: str) -> str | None:
    """本实例自身正在运行的服务名；没有运行中的容器或无法查询时返回 None。"""
    containers = project_containers(name)
    if not containers:
        return None
    for item in containers:
        if item["state"] == "running":
            return item["service"]
    return None


def running_container(name: str) -> tuple[str, str]:
    project = project_name(name)
    listing = run(["docker", "ps", "--filter", f"label=com.docker.compose.project={project}",
                   "--format", "{{.ID}}"], check=False)
    containers = (listing.stdout or "").strip().splitlines()
    if not containers:
        fail(f"实例 {name} 没有运行中的容器")
    container = containers[0]
    inspect = run(["docker", "inspect", "--format", "{{.State.StartedAt}}", container])
    return container, inspect.stdout.strip()


def command_url(args: argparse.Namespace) -> None:
    _, manifest = load_instance(args.name)
    require_docker_registration(args.name, manifest)
    if manifest.get("profile") == "web-lan":
        running_container(args.name)
        deadline = time.monotonic() + 30.0
        while True:
            probe = probe_login_url(manifest["port"], manifest.get("web_base_path", "/"))
            if probe["ok"]:
                print(instance_base_url(manifest))
                return
            if time.monotonic() >= deadline:
                fail(f"密码登录入口探针失败：{probe['reason']}")
            time.sleep(1.0)
    if manifest.get("unsafe_no_auth", False):
        running_container(args.name)
        deadline = time.monotonic() + 30.0
        while True:
            probe = probe_no_auth_url(manifest["port"], manifest.get("web_base_path", "/"))
            if probe["ok"]:
                print(instance_base_url(manifest))
                return
            if time.monotonic() >= deadline:
                fail(f"免认证入口探针失败：{probe['reason']}")
            time.sleep(1.0)
    if not args.non_interactive and not sys.stdout.isatty():
        fail(
            "标准输出不是交互终端；认证 URL 含本次进程 Token。"
            "确需由脚本或 IDE 消费时显式加 --non-interactive，并自行保护标准输出"
        )
    container, started_at = running_container(args.name)
    deadline = time.monotonic() + 30.0
    while True:
        logs = run(["docker", "logs", "--since", started_at, container], check=False).stdout or ""
        url = extract_auth_url(logs, manifest["port"], manifest.get("web_base_path", "/"))
        probe = probe_url(url, manifest["port"]) if url is not None else None
        if probe is not None and probe["ok"]:
            break
        if time.monotonic() >= deadline:
            if url is None:
                fail("未从本次进程日志中取得唯一的认证 URL（不返回历史链接，也不拼造 Token）")
            fail(f"认证 URL 探针失败：{probe['reason']}")
        time.sleep(1.0)
    if args.non_interactive:
        print("警告：标准输出含本次进程认证 URL（敏感），调用方负责管道与终端记录。", file=sys.stderr)
    print(url)


class NoRedirectHandler(urllib.request.HTTPRedirectHandler):
    """禁止自动跟随重定向：Token 入口的 303 本身就是核验证据，不能被吞成 200。"""

    def redirect_request(self, request, file_pointer, code, message, headers, new_url):
        return None


def probe_login_url(port: int, base_path: str = "/") -> dict:
    """确认未认证页面被送往本机密码登录页，且登录表单可用。"""
    root = f"http://127.0.0.1:{port}{base_path}"
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}), NoRedirectHandler())
    try:
        request = urllib.request.Request(root, headers={"Accept": "text/html"}, method="GET")
        try:
            with opener.open(request, timeout=20) as response:
                return {"ok": False, "reason": f"未认证根页面未重定向（HTTP {response.status}）"}
        except urllib.error.HTTPError as error:
            status = error.code
            location = error.headers.get("Location", "")
            error.close()
        parsed = urllib.parse.urlsplit(urllib.parse.urljoin(root, location))
        if status != 302 or parsed.scheme != "http" or parsed.hostname != "127.0.0.1" \
                or parsed.port != port or parsed.path != base_path + "auth/login":
            return {"ok": False, "reason": f"未认证根页面返回意外登录跳转（HTTP {status}）"}
        login = urllib.parse.urljoin(root, location)
        with opener.open(urllib.request.Request(login, headers={"Accept": "text/html"}, method="GET"),
                         timeout=20) as response:
            html = response.read(65536).decode("utf-8", "replace")
            if response.status != 200:
                return {"ok": False, "reason": f"登录页面 HTTP {response.status}"}
        if f'action="{base_path}auth/login"' not in html or 'name="username"' not in html:
            return {"ok": False, "reason": "登录页面缺少密码登录表单"}
        return {"ok": True, "reason": "root 302→login 200"}
    except (urllib.error.HTTPError, urllib.error.URLError, OSError, ValueError) as error:
        return {"ok": False, "reason": f"{type(error).__name__}"}


def probe_no_auth_url(port: int, base_path: str = "/") -> dict:
    """不用 Token/Cookie 请求根页面；只接受直接返回的 DSH Web。"""
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}), NoRedirectHandler())
    try:
        with opener.open(urllib.request.Request(f"http://127.0.0.1:{port}{base_path}", method="GET"),
                         timeout=20) as response:
            html = response.read(65536).decode("utf-8", "replace")
            if response.status != 200 or "__DSH_BOOT__" not in html:
                return {"ok": False, "reason": f"根页面未直接返回 DSH Web（HTTP {response.status}）"}
        return {"ok": True, "reason": "root 200 without Token/Cookie"}
    except urllib.error.HTTPError as error:
        error.close()
        return {"ok": False, "reason": f"根页面 HTTP {error.code}"}
    except (urllib.error.URLError, OSError, ValueError) as error:
        return {"ok": False, "reason": f"{type(error).__name__}"}


def probe_url(url: str, port: int) -> dict:
    jar = http.cookiejar.CookieJar()
    opener = urllib.request.build_opener(
        urllib.request.ProxyHandler({}), urllib.request.HTTPCookieProcessor(jar), NoRedirectHandler()
    )
    try:
        request = urllib.request.Request(url, method="GET")
        try:
            with opener.open(request, timeout=20) as response:
                status = response.status
        except urllib.error.HTTPError as error:
            status = error.code
            error.close()
        if status not in (200, 301, 302, 303, 307, 308):
            return {"ok": False, "reason": f"Token 入口返回意外状态（HTTP {status}）"}
        if not any(cookie.name for cookie in jar):
            return {"ok": False, "reason": f"Token 入口未建立会话 Cookie（HTTP {status}）"}
        parsed = urllib.parse.urlsplit(url)
        root = urllib.parse.urlunsplit((parsed.scheme, parsed.netloc, parsed.path, "", ""))
        try:
            with opener.open(urllib.request.Request(root, method="GET"), timeout=20) as response:
                root_status = response.status
                html = response.read(65536).decode("utf-8", "replace")
        except urllib.error.HTTPError as error:
            error.close()
            return {"ok": False, "reason": f"认证后根页面 HTTP {error.code}"}
        if root_status != 200:
            return {"ok": False, "reason": f"认证后根页面 HTTP {root_status}"}
        if "__DSH_BOOT__" not in html:
            return {"ok": False, "reason": "根页面缺少 __DSH_BOOT__"}
        return {"ok": True, "reason": f"token({status})→cookie→root 200"}
    except (urllib.error.URLError, OSError, ValueError) as error:
        return {"ok": False, "reason": f"{type(error).__name__}"}


def command_logs(args: argparse.Namespace) -> None:
    target, manifest = load_instance(args.name)
    require_docker_registration(args.name, manifest)
    logs = run(compose_command(target, args.name, "logs", "--no-color", "--tail", str(args.tail), "dsh"),
               env=instance_compose_env(manifest)).stdout or ""
    sys.stdout.write(redact_secrets(logs))


def project_containers(name: str) -> list[dict] | None:
    """查询本实例实际容器状态；查询失败返回 None，由调用方按未知处理。"""
    listing = run(
        ["docker", "ps", "-a", "--filter", f"label=com.docker.compose.project={project_name(name)}",
         "--format", "{{.ID}}\t{{.State}}\t{{.Status}}\t{{.Names}}\t{{.Label \"com.docker.compose.service\"}}"],
        check=False,
    )
    if listing.returncode != 0:
        return None
    containers = []
    for line in (listing.stdout or "").strip().splitlines():
        fields = line.split("\t")
        if len(fields) != 5:
            return None
        match = re.search(r"Exited \((-?\d+)\)", fields[2])
        containers.append({"id": fields[0], "state": fields[1], "status": fields[2],
                           "name": fields[3], "service": fields[4],
                           "exit_code": int(match.group(1)) if match else None})
    return containers


def require_unused_docker_name(name: str) -> None:
    """独立登记目录不隔离 Docker 名称；新建不能接管已有的全局资源。"""
    containers = project_containers(name)
    exact = run(["docker", "ps", "-a", "--filter", f"name=^/{name}$", "--format", "{{.ID}}"], check=False)
    if containers is None or exact.returncode != 0:
        fail("无法确认同名 Docker 项目或容器是否存在；未创建实例")
    if containers or (exact.stdout or "").strip():
        fail(f"Docker 中已存在同名项目或容器 {name}，但当前工作区没有对应登记；请使用新的实例名")


def docker_registration_matches(name: str, containers: list[dict]) -> bool:
    """Compose 自身记录的配置路径确定登记来源，避免停止后被其它工作区复用的同名项目。"""
    target = (instance_dir(name) / "compose.yaml").resolve()
    admitted = {target}
    if target.is_relative_to(REPO.resolve()):
        relative = target.relative_to(REPO.resolve())
        admitted.update(Path(root).resolve() / relative
                        for root in (workspace_descriptor(REPO) or {}).get("legacyRoots", []))
    for container in containers:
        if not isinstance(container, dict):
            return False
        config, working = container.get("ConfigFiles"), container.get("WorkingDir")
        if not isinstance(config, str) or not isinstance(working, str) \
                or not Path(config).is_absolute() or not Path(working).is_absolute():
            return False
        path = Path(config).resolve()
        if path not in admitted or Path(working).resolve() != path.parent:
            return False
    return True


def require_docker_registration(name: str, manifest: dict) -> None:
    require_instance_workspace(name, manifest)
    listed = run(["docker", "ps", "-a", "--filter", f"label=com.docker.compose.project={project_name(name)}",
                  "--format", '{"ConfigFiles":{{json (.Label "com.docker.compose.project.config_files")}},"WorkingDir":{{json (.Label "com.docker.compose.project.working_dir")}}}'], check=False)
    try:
        containers = [json.loads(line) for line in (listed.stdout or "").splitlines() if line.strip()]
        matched = listed.returncode == 0 and docker_registration_matches(name, containers)
    except (ValueError, TypeError):
        matched = False
    if not matched:
        fail(f"同名 Docker 项目 {name} 不属于当前实例登记或无法确认归属；未读取或变更该容器")


def wait_for_service(name: str, service: str, timeout: float = 20.0) -> list[dict] | None:
    """等待指定服务进入运行状态；超时返回最后一次观测，无法查询返回 None。"""
    deadline = time.monotonic() + timeout
    while True:
        containers = project_containers(name)
        if containers is None:
            return None
        if any(item["service"] == service and item["state"] == "running" for item in containers):
            return containers
        if time.monotonic() >= deadline:
            return containers
        time.sleep(1.0)


def container_owns_listener(container_id: str, port: int) -> bool:
    """host 网络中的 /proc/net 是共享的，只有本容器进程持有 socket 才算就绪。"""
    script = r"""
const fs = require('node:fs');
const port = Number(process.argv[1]);
const inodes = new Set();
for (const file of ['/proc/net/tcp', '/proc/net/tcp6']) {
  if (!fs.existsSync(file)) continue;
  for (const row of fs.readFileSync(file, 'utf8').trim().split('\n').slice(1)) {
    const fields = row.trim().split(/\s+/);
    const [address, hexPort] = fields[1].split(':');
    // 回环探针必须对应 IPv4 回环或任意地址，不能只是在其它网卡上监听同一端口。
    if (fields[3] === '0A' && parseInt(hexPort, 16) === port &&
        ['00000000', '0100007F', '00000000000000000000000000000000'].includes(address)) {
      inodes.add(fields[9]);
    }
  }
}
let owned = false;
for (const pid of fs.readdirSync('/proc').filter(value => /^\d+$/.test(value))) {
  try {
    for (const fd of fs.readdirSync(`/proc/${pid}/fd`)) {
      try {
        const match = /^socket:\[(\d+)\]$/.exec(fs.readlinkSync(`/proc/${pid}/fd/${fd}`));
        if (match && inodes.has(match[1])) owned = true;
      } catch {}
    }
  } catch {}
}
process.stdout.write(JSON.stringify({owned}));
"""
    try:
        probe = run(["docker", "exec", container_id, "node", "-e", script, str(port)],
                    check=False, timeout=5)
        return probe.returncode == 0 and json.loads(probe.stdout).get("owned") is True
    except (OSError, subprocess.TimeoutExpired, ValueError, AttributeError):
        return False


def wait_for_instance_listener(name: str, port: int, timeout: float = 30.0) -> bool:
    _, manifest = load_instance(name)
    require_docker_registration(name, manifest)
    deadline = time.monotonic() + timeout
    while True:
        containers = project_containers(name)
        running = [item for item in containers or [] if item["service"] == "dsh" and item["state"] == "running"]
        if len(running) != 1 or not running[0].get("id"):
            return False
        identity = running[0]["id"]
        if container_owns_listener(identity, port):
            # 监听探测期间也可能退出，不能用探测前的短暂 running 作为成功回执。
            return any(item.get("id") == identity and item["state"] == "running"
                       for item in project_containers(name) or [])
        if time.monotonic() >= deadline:
            return False
        time.sleep(0.25)


def home_volume(manifest: dict) -> tuple[str | None, bool | None]:
    """按 Compose 自身的卷标签解析本实例 HOME 卷，返回 (卷名, 是否存在)。

    Compose 会把项目名前缀加到卷名上，因此不能按模板里的声明名或 `<project>-home` 猜测；
    查询失败返回 (None, None)，由调用方按未知处理。
    """
    if manifest.get("home_directory"):
        directory = Path(manifest["home_directory"])
        return None, directory.is_dir() and not directory.is_symlink()
    project = manifest.get("project") or project_name(str(manifest.get("name")))
    declared = f"{project}-home"
    listing = run(["docker", "volume", "ls",
                   "--filter", f"label=com.docker.compose.project={project}",
                   "--filter", f"label=com.docker.compose.volume={declared}",
                   "--format", "{{.Name}}"], check=False)
    if listing.returncode != 0:
        return None, None
    names = [line for line in (listing.stdout or "").split() if line]
    if not names:
        return declared, False
    return names[0], True


def stop_instance(name: str, manifest: dict) -> dict:
    """停止实例自身的容器并如实报告结果，保留 HOME 数据卷。

    命令失败、仍有容器运行或状态未知都不报告停止成功。`down` 与 `up --replace` 共用本函数，
    因此旧状态实例走的是同一条路径：先按它自己的 compose 停掉，再按新版本重建。
    """
    require_docker_registration(name, manifest)
    target = instance_dir(name)
    completed = run(compose_command(target, name, "down", "--remove-orphans"),
                    check=False, env=instance_compose_env(manifest))
    if completed.returncode != 0:
        detail = redact_secrets((completed.stderr or completed.stdout or "").strip())
        fail(f"停止 {name} 失败（docker compose down 退出码 {completed.returncode}），实例状态未确认：{detail[-400:]}")
    containers = project_containers(name)
    resolved_volume, preserved = home_volume(manifest)
    report = {
        "name": name,
        "project": manifest.get("project"),
        "home_volume": resolved_volume,
        "home_preserved": preserved,
    }
    if containers is None:
        report["stopped"] = "unknown"
        report["detail"] = "docker ps 查询失败，无法确认实例是否已停止；不报告停止成功"
        print(json.dumps(report, ensure_ascii=False), file=sys.stderr)
        raise SystemExit(1)
    running = [item for item in containers if item["state"] == "running"]
    report["containers"] = containers
    report["stopped"] = not running
    report["containers_removed"] = not containers
    if running:
        print(json.dumps(report, ensure_ascii=False), file=sys.stderr)
        fail("docker compose down 返回 0，但以下容器仍在运行：" + "、".join(item["name"] for item in running))
    return report


def command_down(args: argparse.Namespace) -> None:
    """停止实例并如实报告结果：命令失败、仍有容器运行或状态未知都不报告停止成功。"""
    _, manifest = load_instance(args.name)
    print(json.dumps(stop_instance(args.name, manifest), ensure_ascii=False))


def delete_instance(name: str, manifest: dict) -> dict:
    """删除已停止实例的容器与本地登记，保留 HOME 卷和研究资产。"""
    require_docker_registration(name, manifest)
    target = instance_dir(name)
    containers = project_containers(name)
    report = {
        "name": name,
        "project": manifest.get("project"),
        "registration_dir": str(target),
    }
    if containers is None:
        report["deleted"] = "unknown"
        report["detail"] = "docker ps 查询失败，无法确认实例是否已停止；拒绝删除登记"
        print(json.dumps(report, ensure_ascii=False), file=sys.stderr)
        raise SystemExit(1)
    state = normalized_instance_state(containers)
    report["state"] = state
    report["containers_before"] = containers
    if state not in {"stopped", "absent"}:
        report["deleted"] = False
        print(json.dumps(report, ensure_ascii=False), file=sys.stderr)
        fail(f"实例 {name} 当前状态为 {state}，只允许删除已停止实例")
    before_volume, before_preserved = home_volume(manifest)
    report["home_volume_before"] = before_volume
    report["home_preserved_before"] = before_preserved
    if containers:
        completed = run(compose_command(target, name, "rm", "-f", "-s"),
                        check=False, env=instance_compose_env(manifest))
        if completed.returncode != 0:
            detail = redact_secrets((completed.stderr or completed.stdout or "").strip())
            fail(f"删除 {name} 已停止容器失败（docker compose rm 退出码 {completed.returncode}）：{detail[-400:]}")
        remaining = project_containers(name)
        if remaining is None:
            report["deleted"] = "unknown"
            report["detail"] = "容器删除后无法复查；拒绝删除登记"
            print(json.dumps(report, ensure_ascii=False), file=sys.stderr)
            raise SystemExit(1)
        if remaining:
            report["deleted"] = False
            report["containers_after"] = remaining
            print(json.dumps(report, ensure_ascii=False), file=sys.stderr)
            fail(f"实例 {name} 仍有容器记录，拒绝删除登记")
    after_volume, after_preserved = home_volume(manifest)
    report["home_volume"] = after_volume
    report["home_preserved"] = after_preserved
    if after_preserved is None:
        report["deleted"] = "unknown"
        report["detail"] = "删除后无法复查 HOME 卷；拒绝删除登记"
        print(json.dumps(report, ensure_ascii=False), file=sys.stderr)
        raise SystemExit(1)
    if before_preserved is True and after_preserved is not True:
        report["deleted"] = False
        report["detail"] = "删除后 HOME 卷未保留；拒绝删除登记"
        print(json.dumps(report, ensure_ascii=False), file=sys.stderr)
        raise SystemExit(1)
    if manifest.get("home_directory"):
        # HOME 位于登记目录之下；删除实例不能同时删除 Session 和原生 MCP 设置。
        (target / "instance.json").unlink()
        (target / "compose.yaml").unlink(missing_ok=True)
    else:
        shutil.rmtree(target)
    report["deleted"] = True
    report["registration_deleted"] = True
    return report


def command_delete(args: argparse.Namespace) -> None:
    """删除已停止实例的容器和登记；不删除 HOME、Session、Agent/source 或历史 Run。"""
    _, manifest = load_instance(args.name)
    print(json.dumps(delete_instance(args.name, manifest), ensure_ascii=False))


def validate_existing_identity(name: str, manifest: dict, contract: dict, mode: str,
                               analysis_workspace: str | None = None) -> None:
    """在任何停止或改写动作之前，核对同名实例能否被本次命令替换。"""
    require_instance_workspace(name, manifest)
    existing_source = manifest.get("source_id")
    existing_mode = manifest.get("mode")
    existing_analysis = (manifest.get("mounts") or {}).get("analysis_workspace")
    if existing_source != contract["source_id"] or existing_mode != mode \
            or existing_analysis != analysis_workspace:
        fail(
            f"实例 {name} 已存在且来源/模式不同或归因 Run 不同；"
            "拒绝替换并保持原实例运行，请改用新的实例名"
        )


def existing_instance(name: str) -> tuple[Path, dict] | None:
    target = instance_dir(name)
    if not target.exists():
        return None
    manifest_path = target / "instance.json"
    if not manifest_path.is_file():
        if set(path.name for path in target.iterdir()) <= {"dsh-home"}:
            return None
        fail(f"实例目录已存在但缺少 instance.json：{target}")
    return load_instance(name)


def selected_home_directory(name: str, current: tuple[Path, dict] | None,
                            *, migrate_home: bool = False) -> str | None:
    directory = instance_dir(name) / "dsh-home"
    if current and current[1].get("home_directory"):
        recorded = Path(current[1]["home_directory"])
        if recorded != directory or not recorded.is_dir() or recorded.is_symlink():
            fail("实例 HOME 目录缺失或与登记目录不一致；拒绝创建空 HOME 替代")
        return str(directory)
    if current and not migrate_home:
        return None
    if migrate_home and (not directory.is_dir() or directory.is_symlink() or not any(directory.iterdir())):
        fail("迁移 HOME 前必须先完整复制原数据至实例 dsh-home/；拒绝使用空 HOME")
    if directory.is_symlink():
        fail("实例 HOME 必须是实体目录")
    return str(directory)


def preflight_new_instance(args: argparse.Namespace, contract: dict) -> None:
    """在停旧实例前校验新 Compose 可展开，不写入实例目录。"""
    analysis_workspace = getattr(args, "analysis_workspace", None)
    home_directory = selected_home_directory(args.name, existing_instance(args.name),
                                              migrate_home=bool(getattr(args, "migrate_home", False)))
    run(["node", str(WEB_ADAPTER / "build.mjs")])
    for filename in ("container-webserver.mjs", "container-web-app.mjs"):
        if not (WEB_ADAPTER / "lib" / filename).is_file():
            fail(f"Web 基址适配器缺少构建产物：{filename}")
    if analysis_workspace is None:
        check_managed_plugin_dependencies(contract, getattr(args, "plugin_node_modules", None))
    with tempfile.TemporaryDirectory(prefix="dsh-dev-preflight-") as location:
        root = Path(location)
        rendered = render_compose(
            (ADAPTER / f"{args.mode}.compose.yaml").read_text(encoding="utf-8"),
            mode=args.mode,
            name=args.name,
            project=project_name(args.name),
            port=args.port,
            runtime_env_names=runtime_env_names(contract, analysis_workspace),
            lan_access=bool(getattr(args, "lan_access", False)),
            analysis_workspace=analysis_workspace is not None,
            trusted_host=getattr(args, "trusted_host", None),
            unsafe_no_auth=bool(getattr(args, "unsafe_no_auth", False)),
            skip_testing_notice=bool(getattr(args, "skip_testing_notice", False)),
            plugin_node_modules=bool(getattr(args, "plugin_node_modules", None)),
            bind_home=home_directory is not None,
            image_fingerprint=contract["image"].get("build_fingerprint"),
            schedule_compat=not analysis_workspace and needs_schedule_compat(contract.get("profile_manifest")),
        )
        compose = root / "compose.yaml"
        compose.write_text(rendered, encoding="utf-8")
        environment = compose_env(
            contract, args.mode, args.port, args.name, analysis_workspace=analysis_workspace,
            plugin_node_modules=getattr(args, "plugin_node_modules", None),
        )
        run(compose_command(root, args.name, "config", "--quiet"), env=environment)


def check_managed_plugin_dependencies(contract: dict, external_modules: str | None = None) -> None:
    """本地插件的运行依赖必须能从已挂载目录解析。"""
    managed = Path(contract["managed"])
    for manifest in managed.glob("*/package.json"):
        dependencies = json.loads(manifest.read_text(encoding="utf-8")).get("dependencies") or {}
        for name in dependencies:
            roots = (manifest.parent / "node_modules", managed / "node_modules")
            if external_modules:
                roots += (Path(external_modules),)
            if not any((root / name).is_dir() for root in roots):
                fail(f"插件 {manifest.parent.name} 缺少运行依赖 {name}；"
                     f"请在 {manifest.parent} 按 package-lock.json 执行 npm ci 后重试")


def migrate_existing_instance(args: argparse.Namespace, contract: dict,
                              current: tuple[Path, dict] | None = None) -> dict | None:
    """`up --replace` 的前置步骤：兼容性检查通过后，停同名实例并保留 HOME。"""
    current = current if current is not None else existing_instance(args.name)
    if current is None:
        return None
    _, manifest = current
    validate_existing_identity(
        args.name, manifest, contract, args.mode, getattr(args, "analysis_workspace", None),
    )
    if not getattr(args, "replace", False):
        return None
    recorded = instance_recorded_port(manifest)
    if recorded is not None and recorded != args.port:
        fail(
            f"实例 {args.name} 记录端口为 {recorded}，与本次 --port {args.port} 不一致；"
            "同名实例不得改端口，请保持原端口或用新的实例名"
        )
    previous_schema = manifest.get("schema_version")
    print(json.dumps({"replacing": args.name, "previous_state_schema": previous_schema},
                     ensure_ascii=False), file=sys.stderr)
    stop = stop_instance(args.name, manifest)
    return {"previous_state_schema": previous_schema, "stop": stop}


def command_image_build(args: argparse.Namespace) -> None:
    script = ADAPTER / "build-image.sh"
    if shutil.which("bash") is None:
        fail("缺少 bash，无法调用 build-image.sh")
    run(["bash", str(script), "--source", args.source], check=True, capture=False, timeout=None)
    print(json.dumps({"built": True, "source": args.source}, ensure_ascii=False))


def command_mcp_promote(args: argparse.Namespace) -> None:
    """将已保存的实例 Web MCP 配置定稿到所选 Experiment 的新卷种子。"""
    _, manifest = load_instance(args.name)
    source_id = manifest.get("source_id", "")
    if not source_id.startswith("experiment:"):
        fail("MCP 配置定稿只支持 Experiment 来源")
    contract = resolve(source_id, repo=REPO)
    managed = Path(contract["managed"])
    seed = managed / "web-profile.seed.patch.yml"
    if manifest.get("mounts", {}).get("managed") != str(managed) or not seed.is_file():
        fail("实例来源与 Candidate MCP 种子不一致")
    require_docker_registration(args.name, manifest)
    container, _ = running_container(args.name)
    script = r'''
const fs = require('node:fs');
const { createRequire } = require('node:module');
const yaml = createRequire('/opt/dsh/packages/mcp/mcp-client/package.json')('js-yaml');
const rows = yaml.load(fs.readFileSync('/var/lib/dsh/profiles/web/cordis.patch.yml', 'utf8'));
if (!Array.isArray(rows)) throw new Error('invalid Web profile patch');
if (!rows.some(row => Array.isArray(row.insert) && row.insert.some(item =>
  item.id === 'mcp-session-manager' && item.name === 'file:///opt/dsh-managed/mcp-manager/index.mjs'))) {
  throw new Error('MCP manager plugin insert missing');
}
const matches = rows.flatMap(row => row.id === 'mcp-session-manager' ? [row]
  : Array.isArray(row.insert) ? row.insert.filter(item => item.id === 'mcp-session-manager') : []);
const current = matches.at(-1);
if (!current || current.name && current.name !== 'file:///opt/dsh-managed/mcp-manager/index.mjs'
  || !Array.isArray(current.config?.servers) || !Array.isArray(current.config?.groups)) {
  throw new Error('MCP manager config missing or overridden');
}
const allowed = new Set(['id', 'serverName', 'description', 'enabled', 'specUrl', 'apiKey',
  'authType', 'authHeader', 'loginUrl', 'loginUsername', 'loginPassword', 'loginTokenPath',
  'url', 'headers', 'managementUrl', 'tools']);
const servers = [];
for (const server of current.config.servers) {
  if (Object.keys(server).some(key => !allowed.has(key))) {
    throw new Error('unexpected MCP server field');
  }
  for (const [address, isSpec] of [[server.specUrl, true], [server.url, false],
    [server.loginUrl, true], [server.managementUrl, false]].filter(([address]) => address)) {
    const url = new URL(address);
    if (!['http:', 'https:'].includes(url.protocol) || url.username || url.password
      || url.hash || (!isSpec && url.search)) {
      throw new Error('MCP URL contains unsupported fields');
    }
  }
  if (server.headers && (!Array.isArray(server.headers) || server.headers.some(header =>
    typeof header.name !== 'string' || typeof header.value !== 'string'))) {
    throw new Error('MCP headers invalid');
  }
  const needsCredential = Boolean(server.apiKey || server.loginPassword || server.headers?.some(header => header.value));
  servers.push({ ...server, enabled: needsCredential ? false : server.enabled,
    apiKey: server.apiKey ? '' : server.apiKey,
    loginPassword: server.loginPassword ? '' : server.loginPassword,
    headers: server.headers?.map(header => ({ name: header.name, value: '' })) });
}
const config = { servers, groups: current.config.groups, sharedToken: '' };
const result = yaml.dump([{ insert: [{ id: 'mcp-session-manager',
  name: 'file:///opt/dsh-managed/mcp-manager/index.mjs', config }] }]);
if (JSON.stringify(yaml.load(result)[0].insert[0].config) !== JSON.stringify(config)) {
  throw new Error('MCP seed round trip failed');
}
process.stdout.write(result);
'''
    result = subprocess.run(["docker", "exec", container, "node", "-e", script],
                            text=True, capture_output=True, timeout=30, check=False)
    if result.returncode or not result.stdout:
        fail("读取 Web profile MCP 配置失败；请检查实例配置和插件状态")
    _atomic_replace(seed, result.stdout.encode("utf-8"))
    print(json.dumps({"source": source_id, "candidate_seed": str(seed),
                      "sha256": hashlib.sha256(result.stdout.encode("utf-8")).hexdigest()},
                     ensure_ascii=False))


def main() -> None:
    global REPO, SOURCES, STATE_ROOT
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--repo", type=Path, default=REPO, help="用户数据工作区根目录")
    commands = parser.add_subparsers(dest="command", required=True)

    init = commands.add_parser("init", help="创建最小 Harness Agent 与首次 Experiment")
    init.add_argument("agent_id", help="小写 kebab-case Agent ID")
    init.set_defaults(handler=command_init)

    build = commands.add_parser("image", help="构建锁定 DSH 镜像")
    build_sub = build.add_subparsers(dest="image_command", required=True)
    build_parser = build_sub.add_parser("build")
    build_parser.add_argument("--source", default="EXP-security-operations-expert-001")
    build_parser.set_defaults(handler=command_image_build)

    up = commands.add_parser("up", help="启动实例（可用 --dry-run 预览）")
    up.add_argument("--source", nargs="?", help="来源选择器；未提供值时列出可用的 experiment:<id>")
    up.add_argument("--mode", nargs="?", choices=MODE_CHOICES, metavar="{eval}", type=normalize_mode,
                    help="eval（被测模式）")
    up.add_argument("--name", help="实例名；默认 <agent-id>-eval")
    up.add_argument("--port", type=int, help=f"宿主 Web 端口；新实例默认从 {AUTO_PORT_START} 起自动选择")
    up.add_argument("--dry-run", action="store_true", help="只输出实例计划，不写状态、不调用 Docker")
    up.add_argument("--replace", action="store_true",
                    help="先停止同名实例自身的容器（保留 HOME 数据卷）再启动；用于重载配置或迁移旧状态")
    up.add_argument("--migrate-home", action="store_true",
                    help="将已复制到登记目录 dsh-home/ 的原 HOME 切换为 bind 挂载；旧数据卷保留")
    up.add_argument("--allow-missing-env", action="store_true",
                    help="显式允许缺少运行时环境变量，仅用于技术装载核验")
    up.add_argument("--lan-access", action="store_true",
                    help="业务实例已统一监听 0.0.0.0；保留此显式标记")
    up.add_argument("--unsafe-no-auth", action="store_true",
                    help="业务实例已统一关闭 Web/API 的 Token 与 Host/Origin 校验；保留此显式标记")
    up.add_argument("--skip-testing-notice", action="store_true",
                    help="业务实例已统一跳过 Web 内测声明弹窗；保留此显式标记")
    up.add_argument("--trusted-host", metavar="HOST[:PORT]",
                    help="允许额外的浏览器请求 Host（如反向代理入口）；不改变监听地址")
    up.add_argument("--analysis-workspace", metavar="PATH",
                    help=argparse.SUPPRESS)
    up.add_argument("--plugin-node-modules", metavar="PATH",
                    help="将已有 Node 插件依赖目录只读挂载到 /opt/node_modules")
    up.set_defaults(handler=command_up)

    ps_parser = commands.add_parser("ps", help="默认列出运行中的实例；加 --all 查看全部状态记录")
    ps_parser.add_argument("-a", "--all", action="store_true", help="包含 stopped、absent（无容器登记）、failed、unknown 和损坏记录")
    ps_parser.set_defaults(handler=command_ps)

    url_parser = commands.add_parser("url", help="取得实例访问 URL")
    url_parser.add_argument("name")
    url_parser.add_argument("--non-interactive", action="store_true",
                            help="Token 模式下允许向非交互标准输出打印认证 URL（含敏感值）")
    url_parser.set_defaults(handler=command_url)

    logs_parser = commands.add_parser("logs", help="输出有界、尽力脱敏的运行日志")
    logs_parser.add_argument("name")
    logs_parser.add_argument("--tail", type=int, default=200)
    logs_parser.set_defaults(handler=command_logs)

    down_parser = commands.add_parser("down", help="停止实例并保留 HOME")
    down_parser.add_argument("name")
    down_parser.set_defaults(handler=command_down)

    delete_parser = commands.add_parser("delete", help="删除已停止实例的容器和登记；保留 HOME")
    delete_parser.add_argument("name")
    delete_parser.set_defaults(handler=command_delete)

    promote_parser = commands.add_parser("mcp-promote", help="将实例 Web MCP 配置定稿到 Experiment Candidate")
    promote_parser.add_argument("name")
    promote_parser.set_defaults(handler=command_mcp_promote)

    args = parser.parse_args()
    REPO = args.repo.expanduser().resolve()
    SOURCES = source_catalog(REPO)
    STATE_ROOT = instances_root(REPO)
    os.environ["HARNESS_ASSET_ROOT"] = str(REPO)
    args.handler(args)


if __name__ == "__main__":
    main()
