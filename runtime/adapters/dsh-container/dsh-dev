    normalize_mode(mode)
    return ANALYSIS_PRESET if analysis_workspace else target_preset(contract)


def target_preset(contract: dict) -> str:
    """本次待评估的目标 preset ID，始终来自所选来源声明。"""
    preset = contract.get("preset_id")
    if not preset:
        fail("所选来源未声明可解析的 preset ID，无法确定待评估目标")
    return preset


def run(command: list[str], *, check: bool = True, capture: bool = True,
        env: dict | None = None, timeout: float | None = 300) -> subprocess.CompletedProcess:
    completed = subprocess.run(
        command, text=True, capture_output=capture, check=False, env=env, timeout=timeout
    )
    if check and completed.returncode != 0:
        detail = redact_secrets((completed.stderr or completed.stdout or "").strip())
        fail(f"命令失败（{command[0]}）：{detail[-400:]}")
    return completed


def image_reference(tag: str | None, image_id: str | None) -> str | None:
    """优先用镜像 ID 固定 Compose；旧状态没有 ID 时保留标签兼容性。"""
    if tag and image_id and IMAGE_ID_RE.fullmatch(image_id):
        return f"{tag}@{image_id}"
    return tag


def needs_schedule_compat(profile_manifest: str | None) -> bool:
    if not profile_manifest or not Path(profile_manifest).is_file():
        return False
    profile = json.loads(Path(profile_manifest).read_text(encoding="utf-8"))
    return "@deepseek-ai/dsh-experimental-schedule-bundle" in profile.get("dsh", {}).get("profile", {}).get("bundles", [])


