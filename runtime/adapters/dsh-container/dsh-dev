        "DSH_EVAL_TARGET_PRESET": ANALYSIS_PRESET if analysis_workspace else target_preset(contract),
        "DSH_EVALUATION_PATCH": contract["evaluation_patch"],
        "DSH_WEB_PROFILE_MANIFEST_HOST": (
            str(ADAPTER / "verification-home-controls/web-profile.package.json")
            if analysis_workspace else contract.get("runtime_profile_manifest", contract.get("profile_manifest", str(ADAPTER / "verification-home-controls/web-profile.package.json")))
        ),
    })
    environment["DSH_WEB_PROFILE_SEED_DIR_HOST"] = str(Path(
        str(ADAPTER / "verification-home-controls/web-profile.package.json") if analysis_workspace
        else contract.get("profile_manifest", environment["DSH_WEB_PROFILE_MANIFEST_HOST"])
    ).parent)
    if analysis_workspace:
        environment["DSH_ANALYSIS_WORKSPACE_HOST"] = analysis_workspace
    else:
        environment.update({
            "DSH_MANAGED_PATCH": contract["patch"],
            "DSH_WORKSPACE_HOST": contract["workspace"],
            "DSH_PRESETS_HOST": contract["presets"],
            "DSH_MANAGED_HOST": contract["managed"],
        })
        if plugin_node_modules:
            environment["DSH_PLUGIN_NODE_MODULES_HOST"] = plugin_node_modules
        if contract.get("runtime_managed_patch"):
            environment["DSH_RUNTIME_MANAGED_PATCH_HOST"] = contract["runtime_managed_patch"]
            environment["DSH_MANAGED_PATCH"] = "/opt/dsh-profile-compat/managed.patch.yml"
    return environment


def required_env_names(contract: dict, analysis_workspace: str | None = None) -> list[str]:
    return ["DEEPSEEK_API_KEY"] if analysis_workspace else list(contract.get("required_env_names") or [])


def runtime_env_names(contract: dict, analysis_workspace: str | None = None) -> list[str]:
    required = required_env_names(contract, analysis_workspace)
    if analysis_workspace:
        return required
    return required + [name for name in contract.get("optional_env_names", []) if os.environ.get(name)]


def existing_runtime_environment(args: argparse.Namespace, contract: dict,
                                 current: tuple[Path, dict] | None) -> dict[str, str]:
    """同一来源重启时，仅从本实例容器恢复调用环境未显式提供的声明变量。"""
    if current is None:
        return {}
    validate_existing_identity(args.name, current[1], contract, args.mode, args.analysis_workspace)
    names = required_env_names(contract, args.analysis_workspace)
    if args.analysis_workspace is None:
        names += list(contract.get("optional_env_names") or [])
    missing = set(names) - os.environ.keys()
    if not missing:
        return {}
    require_docker_registration(args.name, current[1])
    listing = run(
        ["docker", "ps", "-a", "--filter", f"label=com.docker.compose.project={project_name(args.name)}",
         "--filter", "label=com.docker.compose.service=dsh", "--format", "{{.ID}}"],
        check=False,
    )
    if listing.returncode != 0:
        fail("无法读取本实例容器的运行环境，原实例未停止")
    containers = [line.strip() for line in (listing.stdout or "").splitlines() if line.strip()]
    if not containers:
        return {}
    if len(containers) != 1:
        fail("本实例存在多个 dsh 容器，无法确定运行环境，原实例未停止")
    inspected = run(["docker", "inspect", "--format", "{{json .Config.Env}}", containers[0]], check=False)
    try:
        values = json.loads(inspected.stdout) if inspected.returncode == 0 else None
        if not isinstance(values, list) or any(not isinstance(value, str) for value in values):
            raise ValueError()
    except (TypeError, ValueError):
        fail("无法解析本实例容器的运行环境，原实例未停止")
    inherited = {}
    for value in values:
        name, separator, content = value.partition("=")
        if separator and name in missing:
            inherited[name] = content
    return inherited


def check_environment(contract: dict, analysis_workspace: str | None = None) -> None:
    missing = [name for name in required_env_names(contract, analysis_workspace) if not os.environ.get(name)]
    if missing:
        fail(
            "以下运行时环境变量未注入，按 fail-closed 拒绝启动："
            + "、".join(missing)
            + "（由受信调用环境按名注入；本工具不读取凭据文件）"
        )


def validate_trusted_host(value: str | None) -> None:
    if value is None:
        return
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9.-]*(?::[1-9][0-9]{0,4})?", value) \
            or (":" in value and int(value.rsplit(":", 1)[1]) > 65535):
        fail("--trusted-host 必须是有效的 HOST 或 HOST:PORT，不含协议、路径或通配符")


def render_compose(template: str, *, mode: str, name: str, project: str, port: int,
                   runtime_env_names: list[str] = (), lan_access: bool = False,
                   analysis_workspace: bool = False, trusted_host: str | None = None,
                   unsafe_no_auth: bool = False, skip_testing_notice: bool = False,
                   plugin_node_modules: bool = False, bind_home: bool = False,
                   image_fingerprint: str | None = None, schedule_compat: bool = False,
                   managed_patch_compat: bool = False) -> str:
    """把受控 Compose 模板渲染为隔离的业务或归因实例配置。"""
    if mode not in MODES:
        fail("mode 只能是 verification")
    if not NAME_RE.fullmatch(name) or project != project_name(name):
        fail("实例名与 Compose 项目名不匹配")
    if lan_access and analysis_workspace:
        fail("归因实例只允许监听 127.0.0.1，不能启用 --lan-access")
    if unsafe_no_auth and analysis_workspace:
        fail("归因实例不能启用 --unsafe-no-auth")
    if plugin_node_modules and analysis_workspace:
        fail("归因实例不能装载业务插件依赖")
    validate_trusted_host(trusted_host)
    fallback_suffix = ""
    if image_fingerprint:
        if not re.fullmatch(r"sha256:[0-9a-f]{64}", image_fingerprint):
            fail("镜像构建指纹格式无效，不能确定只读安装 fallback 卷")
        fallback_suffix = "-" + image_fingerprint[7:19]
    text = template
    replacements = [
        (f"name: ai-agent-harness-dsh-{mode}", f"name: {project}"),
        (f"dsh-{mode}-home", f"{project}-home"),
        (f"dsh-{mode}-trusted-fallback", f"{project}-fallback{fallback_suffix}"),
    ]
    for old, new in replacements:
        if text.count(old) < 1:
            fail(f"Compose 模板缺少预期锚点：{old}")
        text = text.replace(old, new)
    if schedule_compat:
        text = text.replace("      - --no-open\n", "      - --patch\n"
                            "      - /opt/dsh-adapter/schedule-compat/cordis.patch.yml\n"
                            "      - --no-open\n")
    if bind_home:
        volume = f"      - type: volume\n        source: {project}-home\n        target: /var/lib/dsh\n"
        if text.count(volume) != 2:
            fail("Compose 模板缺少两个 HOME 挂载锚点")
        text = text.replace(volume, "      - type: bind\n"
                            "        source: ${DSH_HOME_HOST:?实例 HOME 路径由启动器注入}\n"
                            "        target: /var/lib/dsh\n")
        text = text.replace(f"  {project}-home:\n", "")
    dsh_service = "  dsh:\n"
    if text.count(dsh_service) != 1:
        fail("Compose 模板缺少唯一的 dsh 服务锚点")
    text = text.replace(dsh_service, dsh_service + f"    container_name: {name}\n")
    web_mount = "        target: /opt/dsh-web\n        read_only: true\n"
    text = text.replace(web_mount, web_mount + "      - type: bind\n"
                        "        source: ${DSH_SITES_CONFIG_HOST:?站点路径由工作区配置注入}\n"
                        "        target: /opt/harness-config/sites.json\n        read_only: true\n")
    if managed_patch_compat:
        text = text.replace(web_mount, web_mount + "      - type: bind\n"
                            "        source: ${DSH_RUNTIME_MANAGED_PATCH_HOST:?兼容 Patch 由启动器注入}\n"
                            "        target: /opt/dsh-profile-compat/managed.patch.yml\n        read_only: true\n")
    working_dir = "    working_dir: /work/harness/workspace\n"
    if text.count(working_dir) != 1:
        fail("Compose 模板缺少唯一的 working_dir 锚点")
    selected_working_dir = (
        f"    working_dir: {CONTAINER_ANALYSIS_WORKSPACE}\n" if analysis_workspace else working_dir
    )
    text = text.replace(working_dir, selected_working_dir + "    network_mode: host\n")
    relative_source = "        source: ./"
    if text.count(relative_source) < 1:
        fail("Compose 模板缺少相对挂载源锚点")
    text = text.replace(relative_source, f"        source: {ADAPTER}/")
    if analysis_workspace:
        workspace_mount = (
            "      - type: bind\n"
            "        source: ${DSH_WORKSPACE_HOST:?工作区根由所选来源注入}\n"
            f"        target: {CONTAINER_WORKSPACE}\n"
            "        read_only: true\n"
        )
        analysis_mount = (
            "      - type: bind\n"
            "        source: ${DSH_ANALYSIS_WORKSPACE_HOST:?归因 Run 根由启动器注入}\n"
            f"        target: {CONTAINER_ANALYSIS_WORKSPACE}\n"
            "        read_only: true\n"
        )
        if text.count(workspace_mount) != 1:
            fail("Compose 模板缺少唯一的业务工作区挂载锚点")
        text = text.replace(workspace_mount, analysis_mount)
        business_mounts = [
            (
            "      - type: bind\n"
            "        source: ${DSH_PRESETS_HOST:?preset 根由所选来源注入}\n"
            "        target: /opt/dsh-presets\n"
            "        read_only: true\n"
            ),
            (
            "      - type: bind\n"
            "        source: ${DSH_MANAGED_HOST:?managed 根由所选来源注入}\n"
            "        target: /opt/dsh-managed\n"
            "        read_only: true\n"
            ),
            (
            "      - type: bind\n"
            f"        source: {ADAPTER}/verification-home-controls/locked-bootstrap.env\n"
            f"        target: {CONTAINER_WORKSPACE}/.env\n"
            "        read_only: true\n"
            ),
        ]
        for mount in business_mounts:
            if text.count(mount) != 1:
                fail("Compose 模板缺少唯一的业务资产挂载锚点")
            text = text.replace(mount, "")
        business_patch = (
            "      - --patch\n"
            "      - ${DSH_MANAGED_PATCH:?Profile patch 路径由所选来源注入}\n"
        )
        if text.count(business_patch) != 1:
            fail("Compose 模板缺少唯一的业务 patch 锚点")
        text = text.replace(business_patch, "")
    if plugin_node_modules:
        managed_mount = (
            "      - type: bind\n"
            "        source: ${DSH_MANAGED_HOST:?managed 根由所选来源注入}\n"
            "        target: /opt/dsh-managed\n"
            "        read_only: true\n"
        )
        if text.count(managed_mount) != 1:
            fail("Compose 模板缺少唯一的 managed 挂载锚点")
        text = text.replace(managed_mount, managed_mount + (
            "      - type: bind\n"
            "        source: ${DSH_PLUGIN_NODE_MODULES_HOST:?插件依赖由启动器注入}\n"
            "        target: /opt/node_modules\n"
            "        read_only: true\n"
        ))
    command_tail = "      - --no-open\n"
    if text.count(command_tail) != 1:
        fail("Compose 模板缺少唯一的 command 锚点")
    if unsafe_no_auth:
        text = text.replace(command_tail, f"      - --patch\n      - {UNSAFE_NO_AUTH_PATCH}\n" + command_tail)
    if skip_testing_notice:
        text = text.replace(command_tail, f"      - --patch\n      - {SKIP_TESTING_NOTICE_PATCH}\n" + command_tail)
    if lan_access:
        text = text.replace(
            command_tail,
            f"      - --patch\n      - {LAN_LISTEN_PATCH}\n"
            + command_tail
            + f"      - --port\n      - \"{port}\"\n",
        )
    else:
        text = text.replace(
            command_tail,
            command_tail + f"      - --host\n      - 127.0.0.1\n      - --port\n      - \"{port}\"\n",
        )
    text = text.replace(
        command_tail,
        "      - --patch\n      - /opt/dsh-adapter/runtime-model.patch.yml\n" + command_tail,
    )
    if trusted_host:
        port_line = f'      - "{port}"\n'
        if text.count(port_line) != 1:
            fail("Compose 模板缺少唯一的 Web port 锚点")
        text = text.replace(port_line, port_line + f'      - --trusted-host\n      - {json.dumps(trusted_host)}\n')
    environment_anchor = "      - DSH_TELEMETRY_DISABLED=1\n"
    if text.count(environment_anchor) != 1:
        fail("Compose 模板缺少唯一的 environment 锚点")
    passthrough = "".join(f"      - {name}\n" for name in dict.fromkeys(runtime_env_names))
    text = text.replace(environment_anchor, environment_anchor + passthrough)
    text = text.replace(environment_anchor, environment_anchor
                        + "      - HARNESS_SITES_CONFIG=/opt/harness-config/sites.json\n")
    return text


def extract_auth_url(log_text: str, port: int, base_path: str | None = None) -> str | None:
    """从日志中提取唯一匹配本次端口与本机回环的认证 URL。"""
    matches = [match for match in TOKEN_URL_RE.finditer(log_text)
               if int(match.group(2)) == port
               and (base_path is None or urllib.parse.urlsplit(match.group(1)).path == base_path)]
    if not matches:
        return None
    urls = {match.group(1) for match in matches}
    if len(urls) != 1:
        return None
    return urls.pop()


def redact_secrets(text: str) -> str:
    def replace(match: re.Match) -> str:
        for index in (1, 2, 3, 5):
            prefix = match.group(index)
            if prefix:
                return prefix + "<redacted>" + (match.group(4) if index == 3 else "")
        return "<redacted>"
    return SECRET_RE.sub(replace, text)


def instance_dir(name: str) -> Path:
    if not NAME_RE.fullmatch(name):
        fail("实例名必须使用小写 kebab-case")
    return STATE_ROOT / name


def project_name(name: str) -> str:
    return f"dsh-dev-{name}"


def write_instance(name: str, *, mode: str, contract: dict, port: int,
                   image_id: str | None = None, lan_access: bool = False,
                   analysis_workspace: str | None = None,
                   trusted_host: str | None = None, unsafe_no_auth: bool = False,
                   skip_testing_notice: bool = False,
                   plugin_node_modules: str | None = None, migrate_home: bool = False) -> Path:
    if lan_access and analysis_workspace:
        fail("归因实例只允许监听 127.0.0.1，不能启用 --lan-access")
    target = instance_dir(name)
    current = existing_instance(name)
    if current is not None:
        _, manifest = current
        validate_existing_identity(name, manifest, contract, mode, analysis_workspace)
    else:
        target.mkdir(parents=True, exist_ok=True)
    original_profile = (str(ADAPTER / "verification-home-controls/web-profile.package.json")
                        if analysis_workspace else contract.get("profile_manifest", str(ADAPTER / "verification-home-controls/web-profile.package.json")))
    runtime_profile = original_profile
    if needs_schedule_compat(original_profile):
        projected = run(["node", str(ADAPTER / "profile-compat.ts"), original_profile,
                         str(target / "profile-compat/web-profile.package.json")])
        runtime_profile = projected.stdout.strip()
    contract["runtime_profile_manifest"] = runtime_profile
    if not analysis_workspace and runtime_profile != original_profile:
        original_patch = str(Path(contract["managed"]) / Path(contract["patch"]).relative_to("/opt/dsh-managed"))
        projected_patch = run(["node", str(ADAPTER / "profile-compat.ts"), "--managed", original_patch,
                               str(target / "profile-compat/managed.patch.yml")]).stdout.strip()
        if projected_patch != original_patch:
            contract["runtime_managed_patch"] = projected_patch
    home_directory = selected_home_directory(name, current, migrate_home=migrate_home)
    if home_directory:
        Path(home_directory).mkdir(exist_ok=True)
        # Docker 会在挂载 profiles/node_modules 子卷前创建缺失的父目录，
        # 属主为 root；提前创建使首次 HOME 初始化仍能以容器用户写入。
        try:
            for relative in ("profiles", "profiles/web"):
                directory = Path(home_directory) / relative
                if directory.is_symlink() or directory.exists() and not directory.is_dir():
                    fail(f"实例 HOME 的受控目录不是普通目录，保留原路径：{directory}")
                directory.mkdir(exist_ok=True)
        except PermissionError:
            fail(f"实例 HOME 无法写入 profiles/web：{home_directory}；请保留原数据并修复目录属主或写权限后重试。")
    template = (ADAPTER / f"{mode}.compose.yaml").read_text(encoding="utf-8")
    rendered = render_compose(
        template,
        mode=mode,
        name=name,
        project=project_name(name),
        port=port,
        runtime_env_names=runtime_env_names(contract, analysis_workspace),
        lan_access=lan_access,
        analysis_workspace=analysis_workspace is not None,
        trusted_host=trusted_host,
        unsafe_no_auth=unsafe_no_auth,
        skip_testing_notice=skip_testing_notice,
        plugin_node_modules=plugin_node_modules is not None,
        bind_home=home_directory is not None,
        image_fingerprint=contract["image"].get("build_fingerprint"),
        schedule_compat=runtime_profile != original_profile,
        managed_patch_compat=bool(contract.get("runtime_managed_patch")),
    )
    (target / "compose.yaml").write_text(rendered, encoding="utf-8")
    manifest = {
        "schema_version": INSTANCE_SCHEMA_VERSION,
        "asset_root": str(REPO),
        "workspace_id": workspace_id(REPO),
        **({"home_directory": home_directory} if home_directory else {}),
        "name": name,
        "container_name": name,
        "project": project_name(name),
        "source_id": contract["source_id"],
        "source_kind": contract["source_kind"],
        "mode": mode,
        "purpose": PURPOSES[mode],
        "agent_id": contract["agent_id"],
        "target_preset": target_preset(contract),
        "session_preset": session_preset(contract, mode, analysis_workspace),
        "profile": "web",
        "lan_access": bool(lan_access),
        "unsafe_no_auth": bool(unsafe_no_auth),
        "skip_testing_notice": bool(skip_testing_notice),
        "trusted_host": trusted_host,
        "listen_host": "0.0.0.0" if lan_access else "127.0.0.1",
        "port": port,
        "image_tag": contract["image"]["local_image_tag"],
        "image_id": image_id,
        "image_build_fingerprint": contract["image"].get("build_fingerprint"),
        "adapter_root": str(ADAPTER),
        "web_adapter_root": str(WEB_ADAPTER),
        "web_base_path": current_web_base_path(),
        "sites_config_file": str(sites_config(REPO)),
        "web_profile_manifest": runtime_profile,
        "web_profile_seed_directory": str(Path(original_profile).parent),
        "evaluation_patch": contract["evaluation_patch"],
        "managed_patch": None if analysis_workspace else (
            "/opt/dsh-profile-compat/managed.patch.yml" if contract.get("runtime_managed_patch") else contract["patch"]),
        **({"runtime_managed_patch_host": contract["runtime_managed_patch"],
            "original_managed_patch": contract["patch"]} if contract.get("runtime_managed_patch") else {}),
        "mounts": ({"analysis_workspace": analysis_workspace} if analysis_workspace else {
            "workspace": contract["workspace"],
            "presets": contract["presets"],
            "managed": contract["managed"],
            **({"plugin_node_modules": plugin_node_modules} if plugin_node_modules else {}),
        }),
        "context_mounts": [],
        "mount_modes": ({"analysis_workspace": "ro"} if analysis_workspace else {
            "workspace": "ro", "presets": "ro", "managed": "ro",
            **({"plugin_node_modules": "ro"} if plugin_node_modules else {}),
        }),
        "required_env_names": required_env_names(contract, analysis_workspace),
        "optional_env_names": [name for name in runtime_env_names(contract, analysis_workspace)
                               if name not in required_env_names(contract, analysis_workspace)],
    }
    (target / "instance.json").write_text(
        json.dumps(manifest, ensure_ascii=False, indent=2, sort_keys=True) + "\n", encoding="utf-8"
    )
    return target


def instance_compose_env(manifest: dict) -> dict:
    """从实例状态重建读取该实例 Compose 所需的环境。

    模板用 ${VAR:?} 声明必填变量（不内联任何仓库内默认路径），所以 `ps`、`logs`、`down`
    也必须按实例自身记录注入，不能依赖调用者的当前环境——否则停止和查询会随环境漂移而失败。

    这里只按"记录里有什么就注入什么"取值，不要求状态文件是最新 schema：旧实例必须仍然能被
    停止和查询，否则新版本会卡在"旧状态拒绝操作、同名 up 又被端口挡住"的死循环里。
    记录里没有的字段不猜：旧模板用 ${VAR:-默认}，缺值可解析；新模板用 ${VAR:?}，
    缺值由 Compose 自己报出变量名。
    """
    mounts = manifest.get("mounts") or {}
    values = {
        "DSH_IMAGE_TAG": image_reference(manifest.get("image_tag"), manifest.get("image_id")),
        "DSH_ADAPTER_HOST": manifest.get("adapter_root") or str(ADAPTER),
        "DSH_HOME_HOST": manifest.get("home_directory"),
        "DSH_SITES_CONFIG_HOST": manifest.get("sites_config_file"),
        "DSH_WEB_ADAPTER_HOST": manifest.get("web_adapter_root"),
        "DSH_WEB_PROFILE_MANIFEST_HOST": manifest.get("web_profile_manifest"),
        "DSH_WEB_PROFILE_SEED_DIR_HOST": (
            manifest.get("web_profile_seed_directory") or
            (str(Path(manifest["web_profile_manifest"]).parent) if manifest.get("web_profile_manifest") else None)
        ),
        "DSH_EVALUATION_PATCH": manifest.get("evaluation_patch"),
        "DSH_DEV_TARGET_HOST": manifest.get("dev_target_file"),
        "DSH_MANAGED_PATCH": manifest.get("managed_patch"),
        "DSH_RUNTIME_MANAGED_PATCH_HOST": manifest.get("runtime_managed_patch_host"),
        "DSH_MANAGED_PATCH_OVERLAY": manifest.get("patch_overlay"),
        "DSH_WORKSPACE_HOST": mounts.get("workspace"),
        "DSH_PRESETS_HOST": mounts.get("presets"),
        "DSH_MANAGED_HOST": mounts.get("managed"),
        "DSH_PLUGIN_NODE_MODULES_HOST": mounts.get("plugin_node_modules"),
        "DSH_ANALYSIS_WORKSPACE_HOST": mounts.get("analysis_workspace"),
        "DSH_EVAL_TARGET_PRESET": manifest.get("target_preset"),
    }
    # 只读兼容旧 authoring 状态，保证历史实例仍可 ps/logs/down；新实例不再写入这些字段。
    for asset in manifest.get("context_mounts") or []:
        if not isinstance(asset, dict) or not asset.get("host"):
            continue
        if asset.get("container") == CONTAINER_REFERENCE:
            values["DSH_REFERENCE_HOST"] = asset["host"]
    environment = dict(os.environ)
    environment.update({key: value for key, value in values.items() if value})
    return environment


