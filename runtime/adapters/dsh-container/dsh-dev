def port_in_use(port: int) -> bool:
    """按实例实际 IPv4 全接口监听方式探测，包含仅绑定局域网地址的服务。"""
    import errno
    import socket

    probe = socket.socket()
    probe.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    try:
        probe.bind(("0.0.0.0", port))
    except OSError as error:
        if error.errno != errno.EADDRINUSE:
            raise
        return True
    finally:
        probe.close()
    return False


def require_up_arguments(args: argparse.Namespace) -> None:
    """缺少核心参数时列出仓库当前可用值，并按 CLI 用法错误退出。"""
    missing = [option for option in ("source", "mode") if not getattr(args, option, None)]
    if not missing:
        return
    print("dsh-dev up 缺少必填参数：" + "、".join(f"--{option}" for option in missing), file=sys.stderr)
    if "source" in missing:
        sources = strict_json(SOURCES).get("sources") or {}
        print("可用 --source：" + "、".join(f"experiment:{name}" for name in sorted(sources)), file=sys.stderr)
    if "mode" in missing:
        print("可用 --mode：eval", file=sys.stderr)
    raise SystemExit(2)


def reserved_instance_ports(exclude_name: str) -> set[int]:
    """读取其它有效实例记录占用的端口；损坏记录不参与自动分配。"""
    ports = set()
    if not STATE_ROOT.is_dir():
        return ports
    for target in STATE_ROOT.iterdir():
        if target.name == exclude_name:
            continue
        try:
            manifest = json.loads((target / "instance.json").read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            continue
        port = instance_recorded_port(manifest)
        if port is not None and 1 <= port <= 65535:
            ports.add(port)
    return ports


def first_available_port(name: str) -> int:
    reserved = reserved_instance_ports(name)
    for port in range(AUTO_PORT_START, 65536):
        if port not in reserved and not port_in_use(port):
            return port
    fail(f"从 {AUTO_PORT_START} 起没有可用 TCP 端口")


@contextmanager
def instance_startup_lock(timeout: float = 120.0):
    """互斥选端口、登记与真正监听；只读 fd 也可 flock，供其它账户共用。"""
    while True:
        try:
            descriptor = os.open(STARTUP_LOCK, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
            break
        except FileNotFoundError:
            try:
                descriptor = os.open(STARTUP_LOCK, os.O_RDONLY | os.O_CREAT | os.O_EXCL
                                     | os.O_NOFOLLOW | os.O_CLOEXEC, 0o644)
                os.fchmod(descriptor, 0o644)
                break
            except FileExistsError:
                continue
    try:
        deadline = time.monotonic() + timeout
        while True:
            try:
                fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    fail("等待其它实例完成启动超时；未分配端口或更改实例，请稍后重试")
                time.sleep(0.1)
        yield
    finally:
        os.close(descriptor)


def prepare_up(args: argparse.Namespace) -> tuple[dict, tuple[Path, dict] | None]:
    """解析来源并补齐确定性的实例名与端口，不修改状态。"""
    require_up_arguments(args)
    args.analysis_workspace = validate_analysis_workspace(getattr(args, "analysis_workspace", None), repo=REPO)
    plugin_node_modules = getattr(args, "plugin_node_modules", None)
    if plugin_node_modules:
        path = Path(plugin_node_modules)
        if not path.is_absolute() or not path.is_dir() or path != path.resolve():
            fail("--plugin-node-modules 必须是已存在的规范化绝对目录")
    if args.analysis_workspace and plugin_node_modules:
        fail("归因实例不能装载业务插件依赖")
    if args.analysis_workspace and bool(getattr(args, "lan_access", False)):
        fail("归因实例只允许监听 127.0.0.1，不能启用 --lan-access")
    if args.analysis_workspace and bool(getattr(args, "unsafe_no_auth", False)):
        fail("归因实例不能启用 --unsafe-no-auth")
    # 业务实例统一采用平台直连设置；专用归因工作进程保持内部访问边界。
    args.lan_access = args.unsafe_no_auth = args.skip_testing_notice = not args.analysis_workspace
    validate_trusted_host(getattr(args, "trusted_host", None))
    contract = resolve(args.source, repo=REPO)
    args.name = args.name or f"{contract['agent_id']}-{PURPOSES[args.mode]}"
    current = existing_instance(args.name)
    if current is not None:
        _, manifest = current
        validate_existing_identity(args.name, manifest, contract, args.mode, args.analysis_workspace)
    if args.port is None:
        if current is not None:
            args.port = instance_recorded_port(current[1])
            if args.port is None:
                fail(f"实例 {args.name} 没有合法的记录端口；请显式指定 --port")
        else:
            args.port = first_available_port(args.name)
    if not isinstance(args.port, int) or not 1 <= args.port <= 65535:
        fail("--port 必须是合法 TCP 端口")
    if current is not None:
        recorded = instance_recorded_port(current[1])
        if recorded is not None and recorded != args.port:
            fail(
                f"实例 {args.name} 记录端口为 {recorded}，与本次 --port {args.port} 不一致；"
                "同名实例不得改端口，请保持原端口或用新的实例名"
            )
    return contract, current


