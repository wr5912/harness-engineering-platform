        raise ValueError("无法生成未占用的 Experiment ID")
    collisions = [str(path.relative_to(repo)) for path in (agent_dir, experiment_dir) if path.exists()]
    if experiment_id in catalog["sources"]:
        collisions.append(f"sources.json:{experiment_id}")
    if collisions:
        raise ValueError("目标已存在，拒绝覆盖：" + "、".join(collisions))

