        result = create_harness(args.agent_id, repo=REPO, sources=SOURCES)
    except (OSError, ValueError, RuntimeError) as exc:
        fail(str(exc))
    print(json.dumps(result, ensure_ascii=False, indent=2))


def normalize_mode(value: str) -> str:
    """把用户可见模式名 eval 规范化为内部 harness 阶段名。"""
    mode = MODE_ALIASES.get(value, value)
    if mode not in MODES:
        fail("mode 只能是 eval")
    return mode


def validate_analysis_workspace(value: str | None, *, repo: Path = REPO) -> str | None:
    """归因只接受仓库内形如 Experiment/runs/run-UUID 的真实、无符号链接目录。"""
    if value is None:
        return None
    path = Path(value)
    try:
        resolved = path.resolve(strict=True)
    except OSError:
        fail("--analysis-workspace 必须是已存在的 Run 目录")
    if not path.is_absolute() or path != resolved or not resolved.is_dir():
        fail("--analysis-workspace 必须是规范化的绝对 Run 目录")
    try:
        relative = resolved.relative_to((repo / "evolution/experiments").resolve())
    except ValueError:
        fail("--analysis-workspace 必须位于本仓库 evolution/experiments 下")
    if len(relative.parts) != 3 or relative.parts[1] != "runs" \
            or not relative.parts[0].startswith("EXP-") or not RUN_ID_RE.fullmatch(relative.parts[2]):
        fail("--analysis-workspace 必须精确指向 Experiment 的 run-UUID 目录")
    try:
        if any(item.is_symlink() for item in resolved.rglob("*")):
            fail("--analysis-workspace 内不得包含符号链接")
    except OSError:
        fail("无法完整检查 --analysis-workspace")
    return str(resolved)


def workspace_to_register(mode: str, analysis_workspace: str | None = None) -> str:
    """被测会话注册 Harness；归因会话注册只读 Run。"""
