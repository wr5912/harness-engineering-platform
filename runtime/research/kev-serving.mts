import { createHash } from 'node:crypto'
import { execFileSync } from 'node:child_process'
import { readFileSync, writeFileSync, mkdirSync, existsSync } from 'node:fs'
import { dirname, resolve } from 'node:path'
import { fileURLToPath, pathToFileURL } from 'node:url'

export const KEV_COMMIT = '2074cc44256200bb37540103fa4572901faa10f3'
export const ENCODING_LIMITS = Object.freeze({ max_state: 384, max_branch: 1024, max_packed: 2048 })
export const HASH_CONTRACT = 'json-wire-sha256/v1'
export const SERVING_ENV = Object.freeze({ KEV_DTYPE: 'fp32', KEV_BACKEND: 'torch', KEV_ATTN: 'eager', KEV_MERGE: '1', KEV_LORA_SCALE: '1', KEV_CUDA_GRAPHS: '0', KEV_FUSED: '0', KEV_DATE_FACTS: '0', KEV_TRUNCATE_STATES: '0' })
const digest = (value: string | Uint8Array) => createHash('sha256').update(value).digest('hex')
const upstreamFiles = ['kev/api.py', 'kev/model.py', 'kev/serve.py'] as const
export interface ServingIdentity { run: string; base: string; temperature: number; dtype: 'float32'; backend: 'torch'; device: 'cuda' }
export interface ServingConfig {
  schema_version: 'kev-serving-admission/v1'; kev_root: string; encoder_revision: string
  upstream_files: Record<string, string>; encoder_source_sha256: string; admission_source_sha256: string; emitter_source_sha256: string; bootstrap_sha256: string
  hash_contract: typeof HASH_CONTRACT; limits: typeof ENCODING_LIMITS; serving: ServingIdentity
}

/** 唯一维护源码在本文件；生成的Python只作官方serve.app的同进程扩展。 */
export function pythonBootstrap(): string {
  return String.raw`# Generated by runtime/research/kev-serving.mts; do not edit.
import argparse, hashlib, hmac, json, math, os, pathlib, subprocess, sys, time, uuid

LIMITS = {"max_state": 384, "max_branch": 1024, "max_packed": 2048}
HASH_CONTRACT = "json-wire-sha256/v1"

def sha(value):
    return hashlib.sha256(value).hexdigest()

def pairs(items):
    value = {}
    for key, item in items:
        if key in value: raise ValueError("duplicate JSON key")
        value[key] = item
    return value

def number(value):
    result = float(value)
    if not math.isfinite(result): raise ValueError("nonfinite JSON number")
    return result

def invalid_constant(value):
    raise ValueError("nonfinite JSON number")

def wire_request(raw):
    # Hash original JSON value tokens, never Python's reserialized numbers/Unicode.
    text = raw.decode("utf-8", errors="strict")
    decoder = json.JSONDecoder(object_pairs_hook=pairs, parse_float=number, parse_constant=invalid_constant)
    def skip(index):
        while index < len(text) and text[index] in " \t\r\n": index += 1
        return index
    index = skip(0)
    if text[index:index+1] != "{": raise ValueError("request object required")
    index += 1
    value, tokens = {}, {}
    while True:
        index = skip(index)
        if text[index:index+1] == "}": index += 1; break
        key, index = decoder.raw_decode(text, index)
        if not isinstance(key, str) or key in value: raise ValueError("duplicate or invalid request key")
        index = skip(index)
        if text[index:index+1] != ":": raise ValueError("missing colon")
        start = skip(index + 1)
        item, index = decoder.raw_decode(text, start)
        value[key], tokens[key] = item, text[start:index].encode("utf-8")
        index = skip(index)
        if text[index:index+1] == "}": index += 1; break
        if text[index:index+1] != ",": raise ValueError("missing comma")
        index = skip(index + 1)
        if text[index:index+1] == "}": raise ValueError("trailing comma")
    if skip(index) != len(text) or not {"state", "questions"} <= value.keys(): raise ValueError("request fields missing")
    return value, {"state_sha256": sha(tokens["state"]), "questions_sha256": sha(tokens["questions"])}

def valid_unicode(value):
    if isinstance(value, str): value.encode("utf-8", errors="strict")
    elif isinstance(value, dict):
        for key, item in value.items(): valid_unicode(key); valid_unicode(item)
    elif isinstance(value, list):
        for item in value: valid_unicode(item)

def capability(config):
    return {"schema_version": "kev-encoding-proof/v1", "hash_contract": HASH_CONTRACT,
        "encoder_repository": "jaredpalmer/kev", "encoder_revision": config["encoder_revision"],
        "encoder_source_sha256": config["encoder_source_sha256"], "admission_source_sha256": config["admission_source_sha256"], "limits": LIMITS}

def install(serve, config):
    from fastapi import Request
    from fastapi.responses import JSONResponse, Response
    from kev.api import SystemOneRequest, to_record
    if config["limits"] != LIMITS or config["hash_contract"] != HASH_CONTRACT: raise ValueError("unsupported admission contract")
    if serve.DATE_FACTS or serve.TRUNCATE_STATES: raise ValueError("date facts and truncation must be disabled")
    app = serve.app
    cap = capability(config)
    def loaded():
        server = app.state.server
        card = next((item for item in serve.models()["models"] if item["name"] == "kev-latest"), None)
        if not card or any(card.get(key) != value for key, value in config["serving"].items()) or server.truncate_states or card.get("cuda_graphs"):
            raise ValueError("loaded serving identity mismatch")
        return server
    app.router.add_event_handler("startup", loaded)

    def measure(raw):
        value, hashes = wire_request(raw)
        proof = {**cap, **hashes, "model": value.get("model", "kev-latest"), "admitted": False,
            "state_tokens": None, "max_branch_tokens": None, "packed_tokens": None}
        try:
            valid_unicode(value)
            req = SystemOneRequest.model_validate(value)
            server = loaded()
            rec, _ = to_record(req)
            enc = server.model.encode(server.tok, rec, max_state=384, max_branch=1024, strict=True)
            state_count = enc["seg"].count(0)
            branch_count = max((state_count + enc["seg"].count(index + 1) for index in range(len(rec["questions"]))), default=state_count)
            proof.update(state_tokens=enc["state_tokens"], max_branch_tokens=branch_count, packed_tokens=len(enc["ids"]))
            if enc.get("state_truncated") or state_count != enc["state_tokens"] or state_count > 384 or branch_count > 1024 or len(enc["ids"]) > 2048:
                raise ValueError("encoding exceeds fixed budget")
            proof["admitted"] = True
            return proof
        except (ValueError, UnicodeError) as error:
            if type(getattr(error, "state_tokens", None)) is int: proof["state_tokens"] = error.state_tokens
            proof.update(model_invocation=False, rejection="KEV_ENCODING_NOT_ADMITTED")
            return proof

    async def attach(response, proof):
        raw = b"".join([part async for part in response.body_iterator])
        headers = dict(response.headers)
        try:
            value = json.loads(raw)
            if not isinstance(value, dict): raise ValueError("object required")
        except (ValueError, UnicodeError):
            return Response(raw, status_code=response.status_code, headers=headers, background=response.background)
        value["harness_encoding"] = proof
        headers.pop("content-length", None)
        return JSONResponse(value, status_code=response.status_code, headers=headers, background=response.background)

    @app.middleware("http")
    async def admission(request: Request, call_next):
        path = request.url.path
        if request.method == "GET" and path == "/v1/models":
            response = await call_next(request)
            return await attach(response, cap) if response.status_code == 200 else response
        if request.method != "POST" or path not in ("/v1/systemone", "/v1/harness/encoding"): return await call_next(request)
        # Leave native bearer auth authoritative, including the added encoding endpoint.
        if serve.API_KEY and not hmac.compare_digest(request.headers.get("authorization", ""), "Bearer " + serve.API_KEY): return await call_next(request)
        started = time.perf_counter()
        try: proof = measure(await request.body())
        except (ValueError, UnicodeError):
            proof = {**cap, "admitted": False, "model_invocation": False, "rejection": "KEV_INVALID_WIRE_REQUEST"}
        if not proof["admitted"]:
            return JSONResponse({"detail": {"code": proof["rejection"]}, "harness_encoding": proof}, status_code=422,
                headers={"x-typesafe-request-id": request.headers.get("x-typesafe-request-id") or uuid.uuid4().hex, "server-timing": "app;dur=%.1f" % ((time.perf_counter()-started)*1000)})
        request.state.harness_encoding = proof
        response = await call_next(request)
        return await attach(response, proof) if path == "/v1/systemone" else response

    @app.post("/v1/harness/encoding")
    async def encoding(request: Request):
        proof = {**request.state.harness_encoding, "model_invocation": False}
        return JSONResponse({"harness_encoding": proof, "model_invocation": False}, headers={"x-typesafe-request-id": request.headers.get("x-typesafe-request-id") or uuid.uuid4().hex})
    return app

def main():
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("--harness-config", required=True)
    own, native = parser.parse_known_args()
    config = json.loads(pathlib.Path(own.harness_config).read_text())
    root = pathlib.Path(config["kev_root"]).resolve()
    actual_bootstrap_sha = sha(pathlib.Path(__file__).read_bytes())
    if config["schema_version"] != "kev-serving-admission/v1" or actual_bootstrap_sha != config["bootstrap_sha256"] or actual_bootstrap_sha != config["admission_source_sha256"]: raise ValueError("bootstrap bytes changed")
    if config["encoder_revision"] != "2074cc44256200bb37540103fa4572901faa10f3": raise ValueError("unpinned encoder")
    required_env = {"KEV_DTYPE": "fp32", "KEV_BACKEND": "torch", "KEV_ATTN": "eager", "KEV_MERGE": "1", "KEV_LORA_SCALE": "1", "KEV_CUDA_GRAPHS": "0", "KEV_FUSED": "0", "KEV_DATE_FACTS": "0", "KEV_TRUNCATE_STATES": "0"}
    if any(os.environ.get(key) != value for key, value in required_env.items()): raise ValueError("explicit native FP32 serving environment required")
    if set(config["upstream_files"]) != {"kev/api.py", "kev/model.py", "kev/serve.py"} or config["upstream_files"]["kev/model.py"] != config["encoder_source_sha256"]: raise ValueError("encoder source manifest mismatch")
    head = subprocess.check_output(["git", "-C", str(root), "rev-parse", "HEAD"], text=True).strip()
    dirty = subprocess.check_output(["git", "-C", str(root), "status", "--porcelain"], text=True).strip()
    if head != config["encoder_revision"] or dirty: raise ValueError("official checkout changed")
    for name, expected in config["upstream_files"].items():
        if sha((root/name).read_bytes()) != expected: raise ValueError("official encoder source changed")
    # Keep official CLI and loader; refuse abbreviation/duplicate overrides and hidden fallback.
    values, index = {}, 0
    while index < len(native):
        key = native[index]
        if key not in ("--run", "--fallback", "--host", "--port", "--device") or key in values or index+1 == len(native): raise ValueError("use canonical official serve options")
        values[key] = native[index+1]; index += 2
    run = config["serving"]["run"]
    if values.get("--run") != run or values.get("--device") != config["serving"]["device"] or values.get("--fallback", run) != run or not (pathlib.Path(run)/"head.pt").is_file(): raise ValueError("actual local checkpoint and device required; no fallback")
    if "--fallback" not in values: native += ["--fallback", run]
    sys.path.insert(0, str(root))
    from kev import serve
    if pathlib.Path(serve.__file__).resolve() != root/"kev/serve.py": raise ValueError("wrong official module")
    install(serve, config)
    sys.argv = [sys.argv[0], *native]
    serve.main()

if __name__ == "__main__": main()
`
}

export function emitKevServing(options: { kevRoot: string; runtimeKevRoot: string; serving: ServingIdentity }) {
  const root = resolve(options.kevRoot)
  if (execFileSync('git', ['-C', root, 'rev-parse', 'HEAD'], { encoding: 'utf8' }).trim() !== KEV_COMMIT
    || execFileSync('git', ['-C', root, 'status', '--porcelain'], { encoding: 'utf8' }).trim()) throw new Error('OFFICIAL_KEV_CHECKOUT_CHANGED')
  if (!options.runtimeKevRoot.startsWith('/') || !options.serving.run.startsWith('/') || options.serving.dtype !== 'float32'
    || options.serving.backend !== 'torch' || options.serving.device !== 'cuda' || !options.serving.base || !Number.isFinite(options.serving.temperature) || options.serving.temperature <= 0) throw new Error('ACTUAL_FP32_SERVING_IDENTITY_REQUIRED')
  const bootstrap = pythonBootstrap(), files = Object.fromEntries(upstreamFiles.map(file => [file, digest(readFileSync(resolve(root, file)))]))
  const config: ServingConfig = { schema_version: 'kev-serving-admission/v1', kev_root: options.runtimeKevRoot, encoder_revision: KEV_COMMIT,
    upstream_files: files, encoder_source_sha256: files['kev/model.py']!, admission_source_sha256: digest(bootstrap), emitter_source_sha256: digest(readFileSync(fileURLToPath(import.meta.url))), bootstrap_sha256: digest(bootstrap), hash_contract: HASH_CONTRACT, limits: ENCODING_LIMITS, serving: options.serving }
  return { bootstrap, config, env: SERVING_ENV }
}

/** 返回原始请求正文，Python/CLI须按data发送；不要使用会重排JSON的json=参数。 */
export function encodingProbeWire(request: { state: unknown; questions: unknown; model?: string }) {
  function check(value: unknown, seen = new Set<object>()): void {
    if (value === null || typeof value === 'string' || typeof value === 'boolean' || typeof value === 'number' && Number.isFinite(value)) return
    if (!value || typeof value !== 'object' || seen.has(value) || !Array.isArray(value) && ![Object.prototype, null].includes(Object.getPrototypeOf(value))
      || Array.isArray(value) && (Object.keys(value).length !== value.length || !Object.keys(value).every((key, index) => key === String(index)))) throw new Error('LOSSLESS_JSON_REQUEST_REQUIRED')
    seen.add(value); Object.values(value).forEach(item => check(item, seen)); seen.delete(value)
  }
  if (!Object.hasOwn(request, 'state') || !Object.hasOwn(request, 'questions') || Object.keys(request).some(key => !['model', 'state', 'questions'].includes(key))) throw new Error('REQUEST_FIELDS_REQUIRED')
  check(request)
  const request_wire_body = JSON.stringify(request)
  return { request_wire_body, state_sha256: digest(JSON.stringify(request.state)), questions_sha256: digest(JSON.stringify(request.questions)), hash_contract: HASH_CONTRACT }
}

if (process.argv[1] && import.meta.url === pathToFileURL(resolve(process.argv[1])).href) {
  try {
    const [command, ...args] = process.argv.slice(2), parsed = new Map<string, string>()
    const expected = command === 'emit' ? ['--kev-root', '--runtime-kev-root', '--serving', '--out', '--config-out'] : command === 'probe' ? ['--request', '--out'] : []
    for (let index = 0; index < args.length; index += 2) {
      const key = args[index]!, value = args[index + 1]
      if (!expected.includes(key) || parsed.has(key) || !value || value.startsWith('--')) throw new Error('CANONICAL_OPTIONS_REQUIRED')
      parsed.set(key, value)
    }
    if (!expected.length || parsed.size !== expected.length) throw new Error('REQUIRED_OPTIONS_MISSING')
    const value = (key: string) => parsed.get(key)!
    let outputs: [string, string][], receipt: unknown
    if (command === 'emit') {
      const emitted = emitKevServing({ kevRoot: value('--kev-root'), runtimeKevRoot: value('--runtime-kev-root'), serving: JSON.parse(readFileSync(value('--serving'), 'utf8')) })
      outputs = [[value('--out'), emitted.bootstrap], [value('--config-out'), JSON.stringify(emitted.config, null, 2) + '\n']]
      receipt = { status: 'emitted', bootstrap_sha256: emitted.config.bootstrap_sha256, admission_source_sha256: emitted.config.admission_source_sha256, emitter_source_sha256: emitted.config.emitter_source_sha256, required_env: emitted.env, model_loaded: false }
    } else {
      const wire = encodingProbeWire(JSON.parse(readFileSync(value('--request'), 'utf8')))
      outputs = [[value('--out'), JSON.stringify(wire) + '\n']]
      receipt = { status: 'probe_prepared', hash_contract: wire.hash_contract, state_sha256: wire.state_sha256, questions_sha256: wire.questions_sha256, request_wire_sha256: digest(wire.request_wire_body), model_loaded: false }
    }
    if (new Set(outputs.map(([path]) => resolve(path))).size !== outputs.length || outputs.some(([path]) => existsSync(path))) throw new Error('OUTPUT_ALREADY_EXISTS')
    for (const [path, content] of outputs) { mkdirSync(dirname(resolve(path)), { recursive: true }); writeFileSync(path, content, { flag: 'wx' }) }
    process.stdout.write(JSON.stringify(receipt) + '\n')
  } catch (error) { process.stderr.write(JSON.stringify({ status: 'failed', error_type: error instanceof Error ? error.message : 'ERROR' }) + '\n'); process.exitCode = 1 }
}
